    <!-- Core JS -->
    <script src="/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="/assets/vendor/libs/popper/popper.js"></script>
    <script src="/assets/vendor/js/bootstrap.js"></script>
    <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/assets/vendor/libs/hammer/hammer.js"></script>
    <script src="/assets/vendor/libs/i18n/i18n.js"></script>
    <script src="/assets/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="/assets/vendor/js/menu.js"></script>

    <!-- Vendors JS -->
    <script src="/assets/vendor/libs/select2/select2.js"></script>
    <script src="/assets/vendor/libs/sweetalert2/sweetalert2.js"></script>

    <!-- Main JS -->
    <script src="/assets/js/main.js"></script>

    <!-- Include DataTables JS -->
    <script src="/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>

    <!-- Page specific JS -->
    <script>
        // First, let's test if jQuery is loaded
        console.log('jQuery version:', typeof $ !== 'undefined' ? $.fn.jquery : 'jQuery not loaded');
        console.log('Document ready test...');

        $(document).ready(function () {
            console.log('jQuery document ready fired!');
            
            // Add debugging
            console.log('Table HTML columns:', $('#productsTable thead th').length);

            // Check if DataTable is already initialized and destroy it
            if ($.fn.DataTable.isDataTable('#productsTable')) {
                console.log('Destroying existing DataTable...');
                $('#productsTable').DataTable().destroy();
                // Clear only tbody, keep thead intact
                $('#productsTable tbody').empty();
            }

            // Wait a bit to ensure no other scripts are interfering
            setTimeout(function() {
                console.log('Initializing DataTable...');
                
                // Simple DataTable initialization
                var table = $('#productsTable').DataTable({
                    processing: true,
                    serverSide: false,
                    destroy: true, // Allow reinitialization
                    ajax: {
                        url: '/api/products',
                        dataSrc: 'data'
                    },
                columns: [
                    { 
                        data: null,
                        orderable: false,
                        render: function(data, type, row) {
                            return `<input type="checkbox" class="form-check-input" value="${row.productSku}">`;
                        }
                    },
                    { 
                        data: 'productTitle',
                        render: function(data, type, row) {
                            const imageHtml = row.images && row.images.length > 0 
                                ? `<img src="${row.images[0]}" style="width: 40px; height: 40px; object-fit: cover;" class="rounded me-2">` 
                                : `<div class="bg-light rounded d-inline-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;"><i class="ri ri-image-line"></i></div>`;
                            
                            return `<div class="d-flex align-items-center">
                                        ${imageHtml}
                                        <div>
                                            <div class="fw-medium">${data}</div>
                                            <small class="text-muted">${row.category}</small>
                                        </div>
                                    </div>`;
                        }
                    },
                    { 
                        data: 'inStock',
                        render: function(data) {
                            return data === 'yes' ? '<span class="alert alert-success"><i class="ri ri-check-line"></i></span>' : '<span class="alert alert-danger"><i class="ri ri-close-line"></i></span>';
                        }
                    },
                    { data: 'productSku' },
                    { 
                        data: 'productPrice',
                        render: function(data) {
                            return `$${parseFloat(data || 0).toFixed(2)}`;
                        }
                    },
                    { data: 'quantity' },
                    { 
                        data: 'status',
                        render: function(data) {
                            return data === 'Published' ? '<span class="badge bg-success">Published</span>' : '<span class="badge bg-danger">Inactive</span>';
                        }
                    },
                    { 
                        data: '_id',
                        orderable: false,
                        render: function(data) {
                            return `<div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-outline-primary" onclick="viewProduct('${data}')" title="View">
                                            <i class="ri ri-eye-line"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" onclick="editProduct('${data}')" title="Edit">
                                            <i class="ri ri-edit-line"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteProduct('${data}')" title="Delete">
                                            <i class="ri ri-delete-bin-line"></i>
                                        </button>
                                    </div>`;
                        }
                    }
                ],
                pageLength: 10,
                responsive: true,
                order: [[1, 'asc']], // Sort by Product column (index 1)
                language: {
                    emptyTable: 'No products found',
                    loadingRecords: 'Loading products...',
                    processing: 'Processing...'
                }                });
                
                // Add debugging for column count
                console.log('DataTable columns configured:', table.columns().count());
            }, 100); // Wait 100ms to avoid conflicts
        });

        // Manual table population removed - using DataTable AJAX instead

        // Fixed the viewProduct function to handle errors properly
        function viewProduct(productId) {
            fetch(`/api/products/${productId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        displayProductDetails(data.product);
                        $('#productDetailsModal').modal('show');
                    } else {
                        Swal.fire('Error', data.message || 'Failed to load product details', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire('Error', error.message || 'Failed to load product details', 'error');
                });
        }

        function editProduct(productId) {
            window.location.href = `/edit-product/${productId}`;
        }

        function deleteProduct(productId) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/api/products/${productId}`, {
                        method: 'DELETE'
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                title: 'Deleted!',
                                text: 'Product has been deleted successfully.',
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                // Reload the DataTable instead of the entire page
                                $('#productsTable').DataTable().ajax.reload();
                            });
                        } else {
                            Swal.fire({
                                title: 'Error!',
                                text: data.message || 'Failed to delete product',
                                icon: 'error'
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Delete error:', error);
                        Swal.fire({
                            title: 'Error!',
                            text: 'Failed to delete product. Please try again.',
                            icon: 'error'
                        });
                    });
                }
            });
        }

        // Updated the view popup style for better appearance
        async function displayProductDetails(product) {
            const formatDate = (date) => date ? new Date(date).toLocaleDateString() : 'N/A';
            const formatDateTime = (date) => date ? new Date(date).toLocaleString() : 'N/A';
            const formatPrice = (price) => price ? '$' + parseFloat(price).toFixed(2) : 'N/A';
            const formatBoolean = (value) => value ? 'Yes' : 'No';
            const formatArray = (arr) => arr && arr.length > 0 ? arr.join(', ') : 'N/A';

            // Fetch vendor information if vendor ID exists
            let vendorInfo = 'N/A';
            if (product.vendor && product.vendor !== 'N/A') {
                try {
                    const vendorResponse = await fetch('/api/sellers-dropdown');
                    const vendorData = await vendorResponse.json();
                    if (vendorData.success) {
                        const vendor = vendorData.sellers.find(s => s._id === product.vendor);
                        if (vendor) {
                            vendorInfo = `${vendor.name} (${vendor.company})`;
                        }
                    }
                } catch (error) {
                    console.error('Error fetching vendor info:', error);
                    vendorInfo = `ID: ${product.vendor}`;
                }
            }

            // Function to fetch and format vendor information
            const formatVendor = async (vendorId) => {
                if (!vendorId) return 'N/A';
                
                try {
                    const response = await fetch('/api/sellers-dropdown');
                    const data = await response.json();
                    
                    if (data.sellers) {
                        const seller = data.sellers.find(s => s._id === vendorId);
                        if (seller) {
                            return seller.company ? 
                                `${seller.full_name} - ${seller.company}` : 
                                seller.full_name;
                        }
                    }
                    return vendorId; // Fallback to ID if seller not found
                } catch (error) {
                    console.error('Error fetching seller info:', error);
                    return vendorId; // Fallback to ID on error
                }
            };

            const imagesHtml = product.images && product.images.length > 0
                ? product.images.map(img => `<img src="${img}" class="img-thumbnail me-2 mb-2" style="width: 100px; height: 100px; object-fit: cover;">`).join('')
                : '<p class="text-muted mb-0">No images uploaded</p>';

            const variantsHtml = product.variants && product.variants.length > 0
                ? product.variants.map(v => {
                    if (v.type && v.values) {
                        return `<span class="badge bg-label-primary me-1 mb-1">${v.type}: ${v.values.join(', ')}</span>`;
                    } else if (v.option && v.value) {
                        return `<span class="badge bg-label-primary me-1 mb-1">${v.option}: ${v.value}</span>`;
                    }
                    return '';
                }).join('')
                : '<p class="text-muted mb-0">No variants configured</p>';

            const tagsHtml = product.tags && product.tags.length > 0
                ? product.tags.map(tag => `<span class="badge bg-label-secondary me-1 mb-1">${tag}</span>`).join('')
                : '<p class="text-muted mb-0">No tags</p>';

            const selectedCountriesHtml = product.selectedCountries && product.selectedCountries.length > 0
                ? product.selectedCountries.map(country => `<span class="badge bg-label-info me-1 mb-1">${country}</span>`).join('')
                : '<p class="text-muted mb-0">N/A</p>';

            // Format vendor info asynchronously and update the display
            formatVendor(product.vendor).then(vendorInfo => {
                const vendorElement = document.getElementById('vendorInfo');
                if (vendorElement) {
                    vendorElement.innerHTML = `<span class="text-heading">${vendorInfo}</span>`;
                }
            });

            document.getElementById('productDetailsContent').innerHTML = `
                <div class="row">
                    <div class="col-lg-6">
                        <!-- Basic Information Card -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Basic Information</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Title:</label></div>
                                    <div class="col-sm-8"><span class="text-heading">${product.productTitle || 'N/A'}</span></div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Category:</label></div>
                                    <div class="col-sm-8"><span class="badge bg-label-primary">${product.category || 'N/A'}</span></div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">SKU:</label></div>
                                    <div class="col-sm-8"><code class="text-heading">${product.productSku || 'N/A'}</code></div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Barcode:</label></div>
                                    <div class="col-sm-8"><span class="text-heading">${product.productBarcode || 'N/A'}</span></div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Status:</label></div>
                                    <div class="col-sm-8">
                                        <span class="badge ${product.status === 'Published' ? 'bg-label-success' : product.status === 'Scheduled' ? 'bg-label-warning' : 'bg-label-danger'}">
                                            ${product.status || 'N/A'}
                                        </span>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Description:</label></div>
                                    <div class="col-sm-8"><p class="text-muted mb-0">${product.description || 'No description available'}</p></div>
                                </div>
                            </div>
                        </div>

                        <!-- Pricing & Tax Card -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Pricing & Tax</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Price:</label></div>
                                    <div class="col-sm-8"><span class="h6 text-success mb-0">${formatPrice(product.productPrice)}</span></div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Discounted Price:</label></div>
                                    <div class="col-sm-8"><span class="h6 text-warning mb-0">${product.productDiscountedPrice ? formatPrice(product.productDiscountedPrice) : 'N/A'}</span></div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Charge Tax:</label></div>
                                    <div class="col-sm-8">
                                        <span class="badge ${product.chargeTax === 'yes' ? 'bg-label-success' : 'bg-label-secondary'}">
                                            ${product.chargeTax === 'yes' ? 'Yes' : 'No'}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Inventory Card -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Inventory</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Quantity:</label></div>
                                    <div class="col-sm-8"><span class="badge bg-label-info">${product.quantity || 0}</span></div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">In Stock:</label></div>
                                    <div class="col-sm-8">
                                        <span class="badge ${product.inStock === 'yes' ? 'bg-label-success' : 'bg-label-danger'}">
                                            ${product.inStock === 'yes' ? 'In Stock' : 'Out of Stock'}
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Vendor:</label></div>
                                    <div class="col-sm-8" id="vendorInfo">
                                        <span class="text-muted">Loading vendor info...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <!-- Physical Properties Card -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Physical Properties</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Weight:</label></div>
                                    <div class="col-sm-8"><span class="text-heading">${product.weight ? product.weight + ' g' : 'N/A'}</span></div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Dimensions:</label></div>
                                    <div class="col-sm-8"><span class="text-heading">${product.dimensions || 'N/A'}</span></div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Manufacturer:</label></div>
                                    <div class="col-sm-8"><span class="text-heading">${product.manufacturer || 'N/A'}</span></div>
                                </div>
                            </div>
                        </div>

                        <!-- Shipping & Delivery Card -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Shipping & Delivery</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Shipping Type:</label></div>
                                    <div class="col-sm-8">
                                        <span class="badge ${product.shippingType === 'company' ? 'bg-label-primary' : 'bg-label-secondary'}">
                                            ${product.shippingType === 'company' ? 'Fulfilled by BzzCo' : 'Fulfilled by Seller'}
                                        </span>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Global Delivery:</label></div>
                                    <div class="col-sm-8">
                                        <span class="badge bg-label-info">
                                            ${product.globalDelivery === 'worldwide' ? 'Worldwide' : product.globalDelivery === 'selected-countries' ? 'Selected Countries' : 'Local Only'}
                                        </span>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Selected Countries:</label></div>
                                    <div class="col-sm-8">${selectedCountriesHtml}</div>
                                </div>
                            </div>
                        </div>

                        <!-- Product Identification Card -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Product Identification</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><label class="form-label fw-medium">ID Type:</label></div>
                                    <div class="col-sm-8"><span class="text-heading">${product.productIdType || 'N/A'}</span></div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-4"><label class="form-label fw-medium">Product ID:</label></div>
                                    <div class="col-sm-8"><code class="text-heading">${product.productId || 'N/A'}</code></div>
                                </div>
                            </div>
                        </div>
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Product Images</h5>
                            </div>
                            <div class="card-body">
                                ${imagesHtml}
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Full Width Cards -->
                <div class="row">
                    

                    <!-- Product Variants Card -->
                    <div class="col-3">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Product Variants</h5>
                            </div>
                            <div class="card-body">
                                ${variantsHtml}
                            </div>
                        </div>
                    </div>

                    <!-- Tags Card -->
                    <div class="col-3">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Tags</h5>
                            </div>
                            <div class="card-body">
                                ${tagsHtml}
                            </div>
                        </div>
                    </div>

                    <!-- Timestamps Card -->
                    <div class="col-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Timestamps</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-8 mb-3">
                                        <div class="row mb-3">
                                            <div class="col-sm-4"><label class="form-label fw-medium">Created At:</label></div>
                                            <div class="col-sm-8"><span class="alert alert-outline-info" style="font-size: 12px;">${formatDateTime(product.createdAt)}</span></div>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="row mb-3">
                                            <div class="col-sm-4"><label class="form-label fw-medium">Updated At:</label></div>
                                            <div class="col-sm-8"><span class="alert alert-outline-primary" style="font-size: 12px;">${formatDateTime(product.updatedAt)}</span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }


    </script>
</body>

</html>