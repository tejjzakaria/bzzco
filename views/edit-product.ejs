<!doctype html>

<html lang="en" class="layout-navbar-fixed layout-menu-fixed layout-compact" dir="ltr" data-skin="default"
    data-bs-theme="light" data-assets-path="/assets/" data-template="vertical-menu-template">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Edit Product - Bzz Co.</title>

    <meta name="description" content="" />
    <link rel="stylesheet" href="/assets/vendor/libs/tagify/tagify.css" />
    <%- include("layout/header") %>
</head>

<body>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu -->
            <%- include("layout/sidebar") %>

                <div class="menu-mobile-toggler d-xl-none rounded-1">
                    <a href="javascript:void(0);"
                        class="layout-menu-toggle menu-link text-large text-bg-secondary p-2 rounded-1">
                        <i class="ri ri-menu-line icon-base"></i>
                        <i class="ri ri-arrow-right-s-line icon-base"></i>
                    </a>
                </div>
                <!-- / Menu -->

                <!-- Layout container -->
                <div class="layout-page">
                    <!-- Navbar -->
                    <%- include("layout/header") %>
                        <!-- / Navbar -->

                        <!-- Content wrapper -->
                        <div class="content-wrapper">
                            <!-- Content -->
                            <div class="container-xxl flex-grow-1 container-p-y">
                                <!-- Breadcrumb -->
                                <nav aria-label="breadcrumb">
                                    <ol class="breadcrumb">
                                        <li class="breadcrumb-item">
                                            <a href="/view-products">Products</a>
                                        </li>
                                        <li class="breadcrumb-item active">Edit Product</li>
                                    </ol>
                                </nav>
                                <form id="editProductForm" enctype="multipart/form-data">
                                    <!-- Action Buttons -->
                                    <div class="d-flex justify-content-end gap-2 mb-4">
                                        <button type="button" class="btn btn-outline-secondary"
                                            onclick="window.history.back()">
                                            <i class="ri ri-arrow-left-line me-2"></i>Back
                                        </button>
                                        <div>
                                            <button type="submit" class="btn btn-primary">
                                                <i class="ri ri-save-line me-2"></i>Update Product
                                            </button>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <!-- Left Column -->
                                        <div class="col-12 col-lg-6">
                                            <!-- Basic Product Information -->
                                            <div class="card mb-4">
                                                <div class="card-header">
                                                    <h5 class="mb-0">Basic Product Information</h5>
                                                </div>
                                                <div class="card-body">
                                                    <input type="hidden" id="productId" name="productId">

                                                    <!-- Product Title -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="productTitle">Product Title
                                                            *</label>
                                                        <input type="text" class="form-control" id="productTitle"
                                                            name="productTitle" placeholder="Enter product title" required>
                                                    </div>

                                                    <!-- Category -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="category">Category *</label>
                                                        <select class="form-select" id="category" name="category"
                                                            required>
                                                            <option value="">Select Category</option>
                                                            <option value="Electronics">Electronics</option>
                                                            <option value="Clothing">Clothing</option>
                                                            <option value="Home & Garden">Home & Garden</option>
                                                            <option value="Sports">Sports</option>
                                                            <option value="Books">Books</option>
                                                            <option value="Toys">Toys</option>
                                                            <option value="Health & Beauty">Health & Beauty</option>
                                                            <option value="Automotive">Automotive</option>
                                                            <option value="Office">Office</option>
                                                            <option value="Household">Household</option>
                                                            <option value="Management">Management</option>
                                                            <option value="Food & Beverages">Food & Beverages</option>
                                                            <option value="Jewelry">Jewelry</option>
                                                            <option value="Pet Supplies">Pet Supplies</option>
                                                        </select>
                                                    </div>

                                                    <!-- Description -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="description">Description</label>
                                                        <textarea class="form-control" id="description"
                                                            name="description" rows="4"
                                                            placeholder="Enter product description"></textarea>
                                                    </div>

                                                    <!-- SKU and Barcode Row -->
                                                    <div class="row">
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label" for="productSku">SKU *</label>
                                                            <input type="text" class="form-control" id="productSku"
                                                                name="productSku" placeholder="Enter SKU" required>
                                                        </div>
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label"
                                                                for="productBarcode">Barcode</label>
                                                            <input type="text" class="form-control" id="productBarcode"
                                                                name="productBarcode" placeholder="Enter barcode">
                                                        </div>
                                                    </div>

                                                    <!-- Weight -->
                                                    <div class="mb-3">
                                                        <label for="weight" class="form-label">Weight</label>
                                                        <input type="number" class="form-control" id="weight"
                                                            name="weight" placeholder="Enter weight">
                                                    </div>

                                                    <!-- Manufacturer -->
                                                    <div class="mb-3">
                                                        <label for="manufacturer"
                                                            class="form-label">Manufacturer</label>
                                                        <input type="text" class="form-control" id="manufacturer"
                                                            name="manufacturer" placeholder="Enter manufacturer">
                                                    </div>

                                                    <!-- Dimensions -->
                                                    <div class="mb-3">
                                                        <label for="dimensions" class="form-label">Dimensions</label>
                                                        <input type="text" class="form-control" id="dimensions"
                                                            name="dimensions" placeholder="Enter dimensions">
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Pricing -->
                                            <div class="card mb-4">
                                                <div class="card-header">
                                                    <h5 class="mb-0">Pricing</h5>
                                                </div>
                                                <div class="card-body">
                                                    <div class="row">
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label" for="productPrice">Price *</label>
                                                            <div class="input-group">
                                                                <span class="input-group-text">$</span>
                                                                <input type="number" class="form-control"
                                                                    id="productPrice" name="productPrice"
                                                                    placeholder="0.00" step="0.01" required>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label"
                                                                for="productDiscountedPrice">Discounted Price</label>
                                                            <div class="input-group">
                                                                <span class="input-group-text">$</span>
                                                                <input type="number" class="form-control"
                                                                    id="productDiscountedPrice"
                                                                    name="productDiscountedPrice" placeholder="0.00"
                                                                    step="0.01">
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Tax Settings -->
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" name="chargeTax"
                                                            id="chargeTax">
                                                        <label class="form-check-label" for="chargeTax">
                                                            Charge tax on this product
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Product Identification -->
                                            <div class="card mb-4">
                                                <div class="card-header">
                                                    <h5 class="card-title mb-0">Product Identification</h5>
                                                </div>
                                                <div class="card-body">
                                                    <div class="row">
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label" for="productIdType">Product ID
                                                                Type</label>
                                                            <select class="form-select" id="productIdType"
                                                                name="productIdType">
                                                                <option value="">Select ID Type</option>
                                                                <option value="ISBN">ISBN</option>
                                                                <option value="UPC">UPC</option>
                                                                <option value="EAN">EAN</option>
                                                                <option value="JAN">JAN</option>
                                                                <option value="GTIN">GTIN</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label" for="productIdNumber">Product ID
                                                                Number</label>
                                                            <input type="text" class="form-control" id="productIdNumber"
                                                                name="productIdNumber" placeholder="Enter ID number">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Right Column -->
                                         
                                        <div class="col-12 col-lg-6">
                                            <!-- Product Images -->
                                            <div class="card mb-4">
                                                <div class="card-header">
                                                    <h5 class="card-title mb-0">Product Images</h5>
                                                </div>
                                                <div class="card-body">
                                                    <!-- Current Images -->
                                                    <div class="mb-3">
                                                        <label class="form-label">Current Images</label>
                                                        <div id="currentImages" class="d-flex flex-wrap gap-2">
                                                            <!-- Images will be loaded here -->
                                                        </div>
                                                    </div>

                                                    <!-- Upload New Images -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="images">Upload New Images</label>
                                                        <input type="file" class="form-control" id="images"
                                                            name="images" multiple accept="image/*">
                                                        <small class="text-muted">You can select multiple images</small>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <!-- Inventory & Organization -->
                                            <div class="card mb-4">
                                                <div class="card-header">
                                                    <h5 class="mb-0">Inventory & Organization</h5>
                                                </div>
                                                <div class="card-body">
                                                    <!-- Quantity -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="quantity">Quantity *</label>
                                                        <input type="number" class="form-control" id="quantity"
                                                            name="quantity" placeholder="Enter quantity" min="0" required>
                                                    </div>

                                                    <!-- Vendor -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="vendor">Vendor</label>
                                                        <select class="select2 form-select" id="vendor" name="vendor">
                                                            <option value="">Select Vendor</option>
                                                            <option value="men-clothing">Men's Clothing</option>
                                                            <option value="women-clothing">Women's Clothing</option>
                                                            <option value="kid-clothing">Kid's Clothing</option>
                                                            <option value="electronics-vendor">Electronics Vendor</option>
                                                            <option value="home-garden-vendor">Home & Garden Vendor</option>
                                                        </select>
                                                    </div>

                                                    <!-- Status and Stock Row -->
                                                    <div class="row">
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label" for="status">Status</label>
                                                            <select class="form-select" id="status" name="status">
                                                                <option value="Published">Published</option>
                                                                <option value="Scheduled">Scheduled</option>
                                                                <option value="Inactive">Inactive</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label">Stock Status</label>
                                                            <div class="form-check form-switch mt-2">
                                                                <input class="form-check-input" type="checkbox"
                                                                    id="inStock" name="inStock">
                                                                <label class="form-check-label" for="inStock">In
                                                                    Stock</label>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Tags -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="tags">Tags</label>
                                                        <input type="text" class="form-control" id="tags" name="tags"
                                                            placeholder="Enter tags">
                                                        <small class="text-muted">Press Enter or comma to add tags</small>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Product Variants -->
                                            <div class="card mb-4">
                                                <div class="card-header">
                                                    <h5 class="card-title mb-0">Product Variants</h5>
                                                </div>
                                                <div class="card-body">
                                                    <div class="variant-repeater">
                                                        <div data-repeater-list="variants">
                                                            <div data-repeater-item>
                                                                <div class="row mb-3">
                                                                    <div class="col-md-5">
                                                                        <div class="form-floating form-floating-outline">
                                                                            <input
                                                                                type="text"
                                                                                class="form-control variant-type"
                                                                                name="type"
                                                                                placeholder="e.g., Size, Color, Material" />
                                                                            <label>Variant Type</label>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-5">
                                                                        <div class="form-floating form-floating-outline">
                                                                            <input
                                                                                type="text"
                                                                                class="form-control variant-values"
                                                                                name="values"
                                                                                placeholder="e.g., Small, Medium, Large" />
                                                                            <label>Values (comma-separated)</label>
                                                                        </div>
                                                                        <small class="form-text text-muted">Separate multiple values with commas</small>
                                                                    </div>
                                                                    <div class="col-md-2 d-flex align-items-center">
                                                                        <button class="btn btn-outline-danger" data-repeater-delete type="button">
                                                                            <i class="ri ri-close-line"></i>
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                                <div class="row mb-3">
                                                                    <div class="col-12">
                                                                        <div class="variant-preview-tags">
                                                                            <small class="text-muted">No values specified</small>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <hr />
                                                            </div>
                                                        </div>
                                                        <div class="mb-0">
                                                            <button class="btn btn-primary" data-repeater-create type="button">
                                                                <i class="ri ri-add-line"></i>
                                                                <span class="align-middle">Add Variant</span>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div id="variantPreview" class="mt-3">
                                                        <!-- Variant preview will be shown here -->
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Shipping & Delivery -->
                                            <div class="card mb-4">
                                                <div class="card-header">
                                                    <h5 class="card-title mb-0">Shipping</h5>
                                                </div>
                                                <div class="card-body">
                                                    <!-- Shipping Type -->
                                                    <div class="mb-3">
                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="radio"
                                                                name="shippingType" id="seller" value="seller">
                                                            <label class="form-check-label" for="seller">
                                                                <strong>Fulfilled by Seller</strong><br>
                                                                <small class="text-muted">You handle delivery</small>
                                                            </label>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio"
                                                                name="shippingType" id="company" value="company">
                                                            <label class="form-check-label" for="company">
                                                                <strong>Fulfilled by BzzCo</strong>
                                                                <span
                                                                    class="badge bg-warning text-dark">RECOMMENDED</span><br>
                                                                <small class="text-muted">We handle delivery</small>
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="card mb-4">
                                                <div class="card-header">
                                                    <h5 class="card-title mb-0">Delivery</h5>
                                                </div>
                                                <div class="card-body">
                                                    <!-- Global Delivery -->
                                                    <div class="mb-3">
                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="radio"
                                                                name="globalDelivery" id="worldwide" value="worldwide">
                                                            <label class="form-check-label" for="worldwide">
                                                                <strong>Worldwide</strong><br>
                                                                <small class="text-muted">Delivery all over the world.</small>
                                                            </label>
                                                        </div>

                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="radio"
                                                                name="globalDelivery" id="selectedCountriesOption" value="selected-countries">
                                                            <label class="form-check-label" for="selectedCountriesOption">
                                                                <strong>Selected Countries</strong><br>
                                                                <small class="text-muted">Delivery to specific countries only.</small>
                                                            </label>
                                                        </div>

                                                        <!-- Selected Countries -->
                                                        <div class="mb-3" id="countriesContainer" style="display: none;">
                                                            <label class="form-label" for="selectedCountries">Selected
                                                                Countries</label>
                                                            <div class="form-floating form-floating-outline">
                                                                <select id="selectedCountries"
                                                                    class="select2 form-select" multiple>
                                                                    <optgroup label="Popular Countries">
                                                                        <option value="USA">USA</option>
                                                                        <option value="Canada">Canada</option>
                                                                        <option value="UK">UK</option>
                                                                        <option value="Germany">Germany</option>
                                                                        <option value="France">France</option>
                                                                        <option value="Australia">Australia</option>
                                                                    </optgroup>
                                                                </select>
                                                                <label for="selectedCountries">Selected
                                                                    Countries</label>
                                                            </div>
                                                        </div>

                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio"
                                                                name="globalDelivery" id="local" value="local">
                                                            <label class="form-check-label" for="local">
                                                                <strong>Local delivery only</strong><br>
                                                                <small class="text-muted">Delivery within the Netherlands only.</small>
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>

                            </div>
                            <!-- / Content -->

                            <!-- Footer -->
                            <%- include("layout/footer") %>
                                <!-- / Footer -->

                                <div class="content-backdrop fade"></div>
                        </div>
                        <!-- Content wrapper -->
                </div>
                <!-- / Layout page -->
        </div>

        <!-- Overlay -->
        <div class="layout-overlay layout-menu-toggle"></div>

        <!-- Drag Target Area To SlideIn Menu On Small Screens -->
        <div class="drag-target"></div>
    </div>
    <!-- / Layout wrapper -->

    <!-- Core JS -->
    <script src="/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="/assets/vendor/libs/popper/popper.js"></script>
    <script src="/assets/vendor/js/bootstrap.js"></script>
    <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/assets/vendor/libs/hammer/hammer.js"></script>
    <script src="/assets/vendor/libs/i18n/i18n.js"></script>
    <script src="/assets/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="/assets/vendor/js/menu.js"></script>

    <!-- Vendors JS -->
     <script src="/assets/vendor/libs/tagify/tagify.js"></script>
    <script src="/assets/vendor/libs/select2/select2.js"></script>
    <script src="/assets/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="/assets/vendor/libs/jquery-repeater/jquery-repeater.js"></script>

    
    <script src="/assets/js/forms-tagify.js"></script>
    <!-- <script src="/assets/js/forms-extras.js"></script> -->


    <!-- Main JS -->
    <script src="/assets/js/main.js"></script>

    <!-- Page specific JS -->
    <script>

        // Initialize Select2
        $(document).ready(function () {
            $('#selectedCountries').select2({
                placeholder: 'Select countries',
                allowClear: true
            });
        });

        $(document).ready(function () {
            $('#category').select2();
        });

        // Initialize Tagify for tags input
        let tagify;
        $(document).ready(function () {
            const tagsInput = document.querySelector('#tags');
            tagify = new Tagify(tagsInput);
        });

        // Get product ID from URL
        const productId = window.location.pathname.split('/').pop();
        let currentProduct = null;

        // Image preview functionality
        document.addEventListener('DOMContentLoaded', function () {
            const imageInput = document.getElementById('images');

            // Ensure the input field allows multiple file selection
            imageInput.setAttribute('multiple', 'true');

            // Create a preview container after the file input
            const previewContainer = document.createElement('div');
            previewContainer.id = 'imagePreview';
            previewContainer.className = 'd-flex flex-wrap gap-2 mt-3';
            imageInput.parentNode.appendChild(previewContainer);

            imageInput.addEventListener('change', function (e) {
                const files = e.target.files;
                previewContainer.innerHTML = ''; // Clear previous previews

                if (files.length > 0) {
                    Array.from(files).forEach((file, index) => {
                        if (file.type.startsWith('image/')) {
                            const reader = new FileReader();

                            reader.onload = function (e) {
                                const imageDiv = document.createElement('div');
                                imageDiv.className = 'position-relative d-inline-block';
                                imageDiv.innerHTML = `
                                    <img src="${e.target.result}" 
                                         alt="Preview ${index + 1}" 
                                         class="img-thumbnail" 
                                         style="width: 100px; height: 100px; object-fit: cover;">
                                    <button type="button" 
                                            class="btn btn-sm btn-danger position-absolute top-0 end-0" 
                                            style="transform: translate(50%, -50%); border-radius: 50%; width: 25px; height: 25px; padding: 0;"
                                            onclick="removePreviewImage(this, ${index})">
                                        <i class="ri-close-line" style="font-size: 12px;"></i>
                                    </button>
                                `;
                                previewContainer.appendChild(imageDiv);
                            };

                            reader.readAsDataURL(file);
                        }
                    });
                }
            });

            // Load product data when page loads
            loadProductData();
        });

        // Remove preview image
        function removePreviewImage(button, index) {
            const imageDiv = button.parentElement;
            imageDiv.remove();

            // Update the file input to remove the selected file
            const imageInput = document.getElementById('images');
            const dt = new DataTransfer();
            const files = imageInput.files;

            for (let i = 0; i < files.length; i++) {
                if (i !== index) {
                    dt.items.add(files[i]);
                }
            }

            imageInput.files = dt.files;
        }

        // Remove current image
        function removeCurrentImage(index) {
            if (currentProduct && currentProduct.images) {
                currentProduct.images.splice(index, 1);
                loadCurrentImages(currentProduct.images);
            }
        }

        // Load product data
        function loadProductData() {
            if (!productId || productId === 'edit-product') {
                Swal.fire('Error', 'Invalid product ID', 'error').then(() => {
                    window.location.href = '/view-products';
                });
                return;
            }

            fetch(`/api/products/${productId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        currentProduct = data.product;
                        populateForm(data.product);
                    } else {
                        throw new Error(data.message || 'Failed to load product');
                    }
                })
                .catch(error => {
                    console.error('Error loading product:', error);
                    Swal.fire('Error', error.message || 'Failed to load product data', 'error').then(() => {
                        window.location.href = '/view-products';
                    });
                });
        }

        // Populate form with product data
        function populateForm(product) {
            document.getElementById('productId').value = product._id;
            document.getElementById('productTitle').value = product.productTitle || '';
            document.getElementById('category').value = product.category || '';
            document.getElementById('description').value = product.description || '';
            document.getElementById('productSku').value = product.productSku || '';
            document.getElementById('productBarcode').value = product.productBarcode || '';
            document.getElementById('weight').value = product.weight || '';
            document.getElementById('manufacturer').value = product.manufacturer || '';
            document.getElementById('dimensions').value = product.dimensions || '';
            document.getElementById('productPrice').value = product.productPrice || '';
            document.getElementById('productDiscountedPrice').value = product.productDiscountedPrice || '';
            document.getElementById('chargeTax').checked = product.chargeTax === 'yes';
            document.getElementById('productIdType').value = product.productIdType || '';
            document.getElementById('productIdNumber').value = product.productId || '';
            document.getElementById('quantity').value = product.quantity || '';
            document.getElementById('vendor').value = product.vendor || '';
            document.getElementById('status').value = product.status || 'Published';
            document.getElementById('inStock').checked = product.inStock === 'yes';
            
            // Handle tags with Tagify
            if (product.tags && Array.isArray(product.tags)) {
                tagify.removeAllTags();
                product.tags.forEach(tag => {
                    tagify.addTags([tag]);
                });
            } else if (typeof product.tags === 'string') {
                tagify.removeAllTags();
                const tagsArray = product.tags.split(',').map(tag => tag.trim()).filter(tag => tag);
                tagsArray.forEach(tag => {
                    tagify.addTags([tag]);
                });
            }

            // Handle shipping and delivery options
            if (product.shippingType) {
                document.querySelector(`input[name="shippingType"][value="${product.shippingType}"]`).checked = true;
            }
            if (product.globalDelivery) {
                document.querySelector(`input[name="globalDelivery"][value="${product.globalDelivery}"]`).checked = true;
                if (product.globalDelivery === 'selected-countries') {
                    document.getElementById('countriesContainer').style.display = 'block';
                    if (product.selectedCountries) {
                        $('#selectedCountries').val(product.selectedCountries).trigger('change');
                    }
                }
            }

            // Load images
            loadCurrentImages(product.images || []);

            // Load variants - reset repeater first
            resetVariantRepeater();
            console.log('Product variants from API:', product.variants);
            if (product.variants && product.variants.length > 0) {
                loadVariants(product.variants);
            } else {
                console.log('No variants found, adding empty row');
                addVariantRowWithData('', []);
            }
        }

        // Load current images
        function loadCurrentImages(images) {
            const container = document.getElementById('currentImages');
            container.innerHTML = '';

            if (images.length === 0) {
                container.innerHTML = '<p class="text-muted">No images uploaded</p>';
                return;
            }

            images.forEach((image, index) => {
                const imageDiv = document.createElement('div');
                imageDiv.className = 'position-relative d-inline-block';
                imageDiv.innerHTML = `
                    <img src="${image}" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;">
                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0" 
                            style="transform: translate(50%, -50%); border-radius: 50%; width: 25px; height: 25px; padding: 0;" 
                            onclick="removeCurrentImage(${index})" title="Remove image">
                        <i class="ri-close-line" style="font-size: 12px;"></i>
                    </button>
                `;
                container.appendChild(imageDiv);
            });
        }

        // Reset variant repeater
        function resetVariantRepeater() {
            console.log('Resetting variant repeater');
            const container = $('[data-repeater-list="variants"]');
            container.empty();
        }

        // Load variants
        function loadVariants(variants) {
            console.log('Loading variants:', variants);
            
            // Clear existing variants first
            $('[data-repeater-list="variants"]').empty();
            
            variants.forEach((variant, index) => {
                // Handle both old format (option/value) and new format (type/values)
                let type = variant.type || variant.option || '';
                let values = [];
                
                if (variant.values && Array.isArray(variant.values)) {
                    values = variant.values;
                } else if (variant.value) {
                    values = [variant.value];
                } else if (variant.values && typeof variant.values === 'string') {
                    values = variant.values.split(',').map(v => v.trim());
                }

                console.log(`Processing variant ${index}:`, { type, values });

                // Add variant row if we have the data
                if (type && values.length > 0) {
                    addVariantRowWithData(type, values);
                }
            });
            
            // If no variants were loaded, add one empty row
            if (variants.length === 0 || $('[data-repeater-item]').length === 0) {
                addVariantRowWithData('', []);
            }
            
            updateVariantPreview();
        }

        // Add variant row with data
        function addVariantRowWithData(type, values) {
            console.log('Adding variant row with data:', { type, values });
            
            const container = $('[data-repeater-list="variants"]');
            
            // Create new variant row HTML
            const variantRowHtml = `
                <div data-repeater-item>
                    <div class="row mb-3">
                        <div class="col-md-5">
                            <div class="form-floating form-floating-outline">
                                <input
                                    type="text"
                                    class="form-control variant-type"
                                    name="type"
                                    placeholder="e.g., Size, Color, Material"
                                    value="${type}" />
                                <label>Variant Type</label>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-floating form-floating-outline">
                                <input
                                    type="text"
                                    class="form-control variant-values"
                                    name="values"
                                    placeholder="e.g., Small, Medium, Large"
                                    value="${Array.isArray(values) ? values.join(', ') : values}" />
                                <label>Values (comma-separated)</label>
                            </div>
                            <small class="form-text text-muted">Separate multiple values with commas</small>
                        </div>
                        <div class="col-md-2 d-flex align-items-center">
                            <button class="btn btn-outline-danger" data-repeater-delete type="button">
                                <i class="ri ri-close-line"></i>
                            </button>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="variant-preview-tags">
                                ${values.length > 0 ? values.map(value => 
                                    `<span class="badge bg-secondary me-1 mb-1">${value}</span>`
                                ).join('') : '<small class="text-muted">No values specified</small>'}
                            </div>
                        </div>
                    </div>
                    <hr />
                </div>
            `;
            
            container.append(variantRowHtml);
            
            // Re-setup event listeners for the new row
            setupVariantEventListeners();
        }

        // Variant management with repeater
        let variantRepeater;

        // Initialize variant repeater
        $(document).ready(function () {
            console.log('Document ready, checking jQuery and repeater...');
            console.log('jQuery version:', $.fn.jquery);
            console.log('Repeater available:', typeof $.fn.repeater);
            console.log('Variant repeater element exists:', $('.variant-repeater').length > 0);
            
            // Always set up event listeners first
            setupVariantEventListeners();
            
            if (typeof $.fn.repeater === 'undefined') {
                console.error('jQuery repeater is not loaded!');
                // Fallback: Add manual button functionality
                setupManualVariantButtons();
                return;
            }
            
            if ($('.variant-repeater').length) {
                console.log('Variant repeater element found, initializing...');
                
                try {
                    variantRepeater = $('.variant-repeater').repeater({
                        initEmpty: false,
                        defaultValues: {
                            'type': '',
                            'values': ''
                        },
                        show: function () {
                            console.log('Adding new variant row');
                            $(this).slideDown();
                            // Re-setup event listeners for new elements
                            setupVariantEventListeners();
                            updateVariantPreview();
                        },
                        hide: function (deleteElement) {
                            console.log('Removing variant row');
                            $(this).slideUp(deleteElement);
                            setTimeout(updateVariantPreview, 300);
                        },
                        ready: function (setIndexes) {
                            console.log('Repeater ready');
                            updateVariantPreview();
                        }
                    });

                    console.log('Variant repeater initialized successfully');
                    // Initial preview update
                    updateVariantPreview();
                } catch (error) {
                    console.error('Error initializing repeater:', error);
                    setupManualVariantButtons();
                }
            } else {
                console.log('Variant repeater element not found');
                setupManualVariantButtons();
            }
        });

        // Setup event listeners for variant inputs
        function setupVariantEventListeners() {
            // Remove existing listeners to prevent duplicates
            $(document).off('input.variants', '.variant-type, .variant-values');
            $(document).off('keyup.variants', '.variant-type, .variant-values');
            
            // Add new listeners
            $(document).on('input.variants keyup.variants', '.variant-type, .variant-values', function() {
                console.log('Variant input changed:', $(this).attr('class'), $(this).val());
                updateVariantTags($(this));
                updateVariantPreview();
            });
        }

        // Fallback manual variant management
        function setupManualVariantButtons() {
            console.log('Setting up manual variant buttons...');
            
            // Handle add button
            $(document).on('click', '[data-repeater-create]', function(e) {
                e.preventDefault();
                console.log('Manual add variant clicked');
                addVariantRowManually();
            });

            // Handle delete buttons
            $(document).on('click', '[data-repeater-delete]', function(e) {
                e.preventDefault();
                console.log('Manual delete variant clicked');
                $(this).closest('[data-repeater-item]').remove();
                updateVariantPreview();
            });

            // Initial preview update
            updateVariantPreview();
        }

        function addVariantRowManually() {
            const container = $('[data-repeater-list="variants"]');
            const template = $('[data-repeater-item]').first().clone();
            
            // Clear values in template
            template.find('input').val('');
            template.find('.variant-preview-tags').html('<small class="text-muted">No values specified</small>');
            
            container.append(template);
            
            // Re-setup event listeners for the new row
            setupVariantEventListeners();
            updateVariantPreview();
        }

        // Update variant tags for a specific row
        function updateVariantTags($input) {
            if ($input.hasClass('variant-values')) {
                const values = $input.val().split(',').map(v => v.trim()).filter(v => v.length > 0);
                const $previewContainer = $input.closest('[data-repeater-item]').find('.variant-preview-tags');
                
                console.log('Updating variant tags for values:', values, 'Container found:', $previewContainer.length);
                
                if (values.length > 0) {
                    const tags = values.map(value => 
                        `<span class="badge bg-secondary me-1 mb-1">${value}</span>`
                    ).join('');
                    $previewContainer.html(tags);
                } else {
                    $previewContainer.html('<small class="text-muted">No values specified</small>');
                }
            }
        }

        // Update variant preview
        function updateVariantPreview() {
            console.log('Updating variant preview...');
            const previewContainer = document.getElementById('variantPreview');
            if (!previewContainer) {
                console.error('Variant preview container not found');
                return;
            }

            const variants = [];
            
            // Collect all variant data from repeater
            $('.variant-repeater [data-repeater-item]').each(function(index) {
                const $item = $(this);
                const type = $item.find('.variant-type').val().trim();
                const valuesString = $item.find('.variant-values').val().trim();
                
                console.log(`Variant ${index}: type="${type}", values="${valuesString}"`);
                
                if (type && valuesString) {
                    const values = valuesString.split(',').map(v => v.trim()).filter(v => v.length > 0);
                    if (values.length > 0) {
                        variants.push({ type, values });
                    }
                }
            });

            console.log('Valid variants found:', variants.length, variants);

            if (variants.length === 0) {
                previewContainer.innerHTML = '<small class="text-muted">No variants configured</small>';
                return;
            }

            // Calculate total combinations
            const totalCombinations = variants.reduce((total, variant) => {
                return total * (variant.values.length || 1);
            }, 1);

            const previewHTML = `
                <div class="alert alert-info">
                    <strong>Variant Preview:</strong><br>
                    ${variants.map(v => `${v.type}: ${v.values.join(', ')}`).join('<br>')}
                    <br><small class="text-muted">Total combinations: ${totalCombinations}</small>
                </div>
            `;
            
            console.log('Setting preview HTML:', previewHTML);
            previewContainer.innerHTML = previewHTML;
        }

        // Expose functions to window for debugging
        window.testVariantPreview = updateVariantPreview;
        window.testVariantTags = updateVariantTags;

        // Show/hide countries selector based on global delivery selection
        document.addEventListener('change', function (e) {
            if (e.target.name === 'globalDelivery') {
                const countriesContainer = document.getElementById('countriesContainer');
                if (e.target.value === 'selected-countries') {
                    countriesContainer.style.display = 'block';
                } else {
                    countriesContainer.style.display = 'none';
                    // Clear selected countries when hiding
                    $('#selectedCountries').val(null).trigger('change');
                }
            }
        });

        document.getElementById('editProductForm').addEventListener('submit', async function (event) {
            event.preventDefault();

            const form = event.target;
            const formData = new FormData();
            
            // Remove all variant-related fields that may have been auto-added by the repeater
            // The repeater generates field names like variants[0][type], variants[0][values], etc.
            const keysToDelete = [];
            for (let [key, value] of formData.entries()) {
                if (key.startsWith('variants[') || key === 'type' || key === 'values') {
                    keysToDelete.push(key);
                }
            }
            keysToDelete.forEach(key => formData.delete(key));

            // Add all form fields explicitly
            formData.append('productTitle', document.getElementById('productTitle').value);
            formData.append('category', document.getElementById('category').value);
            formData.append('description', document.getElementById('description').value);
            formData.append('productSku', document.getElementById('productSku').value);
            formData.append('productBarcode', document.getElementById('productBarcode').value || '');
            formData.append('weight', document.getElementById('weight').value || '');
            formData.append('manufacturer', document.getElementById('manufacturer').value || '');
            formData.append('dimensions', document.getElementById('dimensions').value || '');
            formData.append('productPrice', document.getElementById('productPrice').value);
            formData.append('productDiscountedPrice', document.getElementById('productDiscountedPrice').value || '');
            formData.append('productIdType', document.getElementById('productIdType').value || '');
            formData.append('productIdNumber', document.getElementById('productIdNumber').value || '');
            formData.append('quantity', document.getElementById('quantity').value);
            formData.append('vendor', document.getElementById('vendor').value || '');
            formData.append('status', document.getElementById('status').value);

            // Handle checkbox values explicitly
            const inStockCheckbox = document.getElementById('inStock');
            const chargeTaxCheckbox = document.getElementById('chargeTax');
            
            formData.append('inStock', inStockCheckbox.checked ? 'yes' : 'no');
            formData.append('chargeTax', chargeTaxCheckbox.checked ? 'yes' : 'no');

            // Handle Tagify tags properly
            if (tagify && tagify.value) {
                const tagsArray = tagify.value.map(tag => tag.value);
                formData.append('tags', tagsArray.join(','));
            } else {
                formData.append('tags', '');
            }

            // Handle shipping and delivery options
            const shippingType = document.querySelector('input[name="shippingType"]:checked');
            if (shippingType) {
                formData.append('shippingType', shippingType.value);
            }

            const globalDelivery = document.querySelector('input[name="globalDelivery"]:checked');
            if (globalDelivery) {
                formData.append('globalDelivery', globalDelivery.value);
            }

            // Handle selectedCountries field properly
            const selectedCountries = $('#selectedCountries').val();
            if (selectedCountries && selectedCountries.length > 0) {
                formData.append('selectedCountries', JSON.stringify(selectedCountries));
            } else {
                formData.append('selectedCountries', '[]');
            }

            // Handle existing images
            if (currentProduct && currentProduct.images) {
                formData.append('existingImages', JSON.stringify(currentProduct.images));
            }

            // Handle variants from repeater
            console.log('=== VARIANT COLLECTION DEBUG ===');
            console.log('Variant repeater elements found:', $('.variant-repeater').length);
            console.log('Variant repeater items found:', $('.variant-repeater [data-repeater-item]').length);
            
            const variants = [];
            $('.variant-repeater [data-repeater-item]').each(function(index) {
                console.log(`Processing variant row ${index}:`);
                
                const $typeInput = $(this).find('.variant-type');
                const $valuesInput = $(this).find('.variant-values');
                
                console.log('  Type input found:', $typeInput.length);
                console.log('  Values input found:', $valuesInput.length);
                
                const type = $typeInput.val() ? $typeInput.val().trim() : '';
                const valuesString = $valuesInput.val() ? $valuesInput.val().trim() : '';
                
                console.log('  Type value:', `"${type}"`);
                console.log('  Values value:', `"${valuesString}"`);
                
                if (type && valuesString) {
                    const values = valuesString.split(',').map(v => v.trim()).filter(v => v.length > 0);
                    console.log('  Parsed values:', values);
                    if (values.length > 0) {
                        const variant = { type, values };
                        variants.push(variant);
                        console.log('  Added variant:', variant);
                    }
                } else {
                    console.log('  Skipped - missing type or values');
                }
            });
            
            console.log('Final variants array:', variants);
            console.log('Variants to be sent:', variants);
            console.log('=== END VARIANT DEBUG ===');
            
            // Always append variants (even if empty array)
            formData.append('variants', JSON.stringify(variants));
            console.log('Added variants to FormData:', JSON.stringify(variants));

            // Handle new image files
            const newImages = document.getElementById('images').files;
            for (let i = 0; i < newImages.length; i++) {
                formData.append('newImages', newImages[i]);
            }
            
            // Debug: Log all FormData entries after cleanup
            console.log('=== FINAL FORMDATA ENTRIES FOR UPDATE ===');
            for (let [key, value] of formData.entries()) {
                if (value instanceof File) {
                    console.log(key, ':', `[File: ${value.name}, size: ${value.size}]`);
                } else {
                    console.log(key, ':', value);
                }
            }
            console.log('=== END FORMDATA DEBUG ===');

            // Validate required fields before sending
            const requiredFields = ['productTitle', 'productSku', 'category'];
            const missingFields = requiredFields.filter(field => !document.getElementById(field).value);
            if (missingFields.length > 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Error',
                    text: `Missing required fields: ${missingFields.join(', ')}`,
                    confirmButtonText: 'OK'
                });
                return;
            }

            // Ensure variants are valid JSON
            try {
                JSON.parse(JSON.stringify(variants));
            } catch (e) {
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Error',
                    text: 'Invalid variants format',
                    confirmButtonText: 'OK'
                });
                return;
            }

            // Ensure selectedCountries are valid JSON
            try {
                JSON.parse(JSON.stringify(selectedCountries));
            } catch (e) {
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Error',
                    text: 'Invalid selected countries format',
                    confirmButtonText: 'OK'
                });
                return;
            }

            try {
                const response = await fetch(`/api/products/${productId}`, {
                    method: 'PUT',
                    body: formData
                });

                const responseText = await response.text();
                console.log('Raw response:', responseText);

                if (response.ok) {
                    let result;
                    try {
                        result = JSON.parse(responseText);
                    } catch (e) {
                        console.error('Failed to parse JSON response:', e);
                        throw new Error('Invalid response format');
                    }
                    
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: 'Product updated successfully!',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        window.location.href = '/view-products';
                    });
                } else {
                    console.log('Response not ok:', response.status, response.statusText);
                    console.log('Error response text:', responseText);
                    
                    let errorMessage = 'Failed to update product.';
                    try {
                        const parsedError = JSON.parse(responseText);
                        errorMessage = parsedError.error || parsedError.message || errorMessage;
                        if (parsedError.details && Array.isArray(parsedError.details)) {
                            errorMessage += '\n\nDetails:\n' + parsedError.details.join('\n');
                        }
                    } catch (e) {
                        console.error('Failed to parse error response:', e);
                        errorMessage = responseText || errorMessage;
                    }
                    
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: errorMessage,
                        confirmButtonText: 'OK'
                    });
                }
            } catch (err) {
                console.log('Fetch error:', err);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An unexpected error occurred: ' + err.message,
                    confirmButtonText: 'OK'
                });
            }
        });

    </script>

</body>
</html>
