<!doctype html>

<html lang="en" class="layout-navbar-fixed layout-menu-fixed layout-compact" dir="ltr" data-skin="default"
    data-bs-theme="light" data-assets-path="/assets/" data-template="vertical-menu-template">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Add Page - Bzz Co.</title>

    <meta name="description" content="" />
    <link rel="stylesheet" href="/assets/vendor/libs/tagify/tagify.css" />
    <%- include("layout/header") %>
</head>

<body>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu -->
            <%- include("layout/sidebar") %>

                <div class="menu-mobile-toggler d-xl-none rounded-1">
                    <a href="javascript:void(0);"
                        class="layout-menu-toggle menu-link text-large text-bg-secondary p-2 rounded-1">
                        <i class="ri ri-menu-line icon-base"></i>
                        <i class="ri ri-arrow-right-s-line icon-base"></i>
                    </a>
                </div>
                <!-- / Menu -->

                <!-- Layout container -->
                <div class="layout-page">
                    <!-- Navbar -->
                    <%- include("layout/header") %>
                        <!-- / Navbar -->

                        <!-- Content wrapper -->
                        <div class="content-wrapper">
                            <!-- Content -->
                            <div class="container-xxl flex-grow-1 container-p-y">
                                <!-- Breadcrumb -->
                                <nav aria-label="breadcrumb">
                                    <ol class="breadcrumb">
                                        <li class="breadcrumb-item">
                                            <a href="/view-pages">Pages</a>
                                        </li>
                                        <li class="breadcrumb-item active">Add Page</li>
                                    </ol>
                                </nav>
                                <form id="addPageForm">
                                    <!-- Action Buttons -->
                                    <div class="d-flex justify-content-end gap-2 mb-4">
                                        <button type="button" class="btn btn-outline-secondary"
                                            onclick="window.history.back()">
                                            <i class="ri ri-arrow-left-line me-2"></i>Back
                                        </button>
                                        <div>
                                            <button type="submit" class="btn btn-primary">
                                                <i class="ri ri-save-line me-2"></i>Add Page
                                            </button>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <!-- Left Column -->
                                        <div class="col-12 col-lg-8">
                                            <!-- Basic Page Information -->
                                            <div class="card mb-4">
                                                <div class="card-header">
                                                    <h5 class="mb-0">Basic Page Information</h5>
                                                </div>
                                                <div class="card-body">
                                                    <!-- Page Title -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="title">Page Title *</label>
                                                        <input type="text" class="form-control" id="title"
                                                            name="title" placeholder="Enter page title" required>
                                                    </div>

                                                    <!-- Slug -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="slug">Slug *</label>
                                                        <input type="text" class="form-control" id="slug"
                                                            name="slug" placeholder="auto-generated-from-title" required>
                                                        <small class="text-muted">URL-friendly version of the title (auto-generated)</small>
                                                    </div>

                                                    <!-- Content -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="content">Content *</label>
                                                        <textarea class="form-control" id="content"
                                                            name="content" rows="15"
                                                            placeholder="Enter page content"></textarea>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- SEO Settings -->
                                            <div class="card mb-4">
                                                <div class="card-header">
                                                    <h5 class="mb-0">SEO Settings</h5>
                                                </div>
                                                <div class="card-body">
                                                    <!-- Meta Description -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="metaDescription">Meta Description</label>
                                                        <textarea class="form-control" id="metaDescription"
                                                            name="metaDescription" rows="3"
                                                            placeholder="Enter meta description (max 160 characters)"
                                                            maxlength="160"></textarea>
                                                        <small class="text-muted"><span id="metaDescLength">0</span>/160 characters</small>
                                                    </div>

                                                    <!-- Meta Keywords -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="metaKeywords">Meta Keywords</label>
                                                        <input type="text" class="form-control" id="metaKeywords"
                                                            name="metaKeywords" placeholder="Enter keywords">
                                                        <small class="text-muted">Press Enter or comma to add keywords</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Right Column -->
                                        <div class="col-12 col-lg-4">
                                            <!-- Page Settings -->
                                            <div class="card mb-4">
                                                <div class="card-header">
                                                    <h5 class="mb-0">Page Settings</h5>
                                                </div>
                                                <div class="card-body">
                                                    <!-- Status -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="status">Status *</label>
                                                        <select class="form-select" id="status" name="status" required>
                                                            <option value="draft">Draft</option>
                                                            <option value="published">Published</option>
                                                            <option value="archived">Archived</option>
                                                        </select>
                                                    </div>

                                                    <!-- Page Type -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="pageType">Page Type *</label>
                                                        <select class="form-select" id="pageType" name="pageType" required>
                                                            <option value="general">General</option>
                                                            <option value="legal">Legal</option>
                                                            <option value="help">Help</option>
                                                        </select>
                                                    </div>

                                                    <!-- Template -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="template">Template *</label>
                                                        <select class="form-select" id="template" name="template" required>
                                                            <option value="default">Default</option>
                                                            <option value="sidebar">With Sidebar</option>
                                                            <option value="full-width">Full Width</option>
                                                        </select>
                                                    </div>

                                                    <!-- Order -->
                                                    <div class="mb-3">
                                                        <label class="form-label" for="order">Order</label>
                                                        <input type="number" class="form-control" id="order"
                                                            name="order" placeholder="0" min="0" value="0">
                                                        <small class="text-muted">Display order (lower numbers appear first)</small>
                                                    </div>

                                                    <!-- Is In Menu -->
                                                    <div class="mb-3">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox"
                                                                id="isInMenu" name="isInMenu">
                                                            <label class="form-check-label" for="isInMenu">
                                                                Show in Menu
                                                            </label>
                                                        </div>
                                                        <small class="text-muted">Display this page in the navigation menu</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>

                            </div>
                            <!-- / Content -->

                            <!-- Footer -->
                            <%- include("layout/footer") %>
                                <!-- / Footer -->

                                <div class="content-backdrop fade"></div>
                        </div>
                        <!-- Content wrapper -->
                </div>
                <!-- / Layout page -->
        </div>

        <!-- Overlay -->
        <div class="layout-overlay layout-menu-toggle"></div>

        <!-- Drag Target Area To SlideIn Menu On Small Screens -->
        <div class="drag-target"></div>
    </div>
    <!-- / Layout wrapper -->

    <!-- Core JS -->
    <script src="/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="/assets/vendor/libs/popper/popper.js"></script>
    <script src="/assets/vendor/js/bootstrap.js"></script>
    <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/assets/vendor/libs/hammer/hammer.js"></script>
    <script src="/assets/vendor/libs/i18n/i18n.js"></script>
    <script src="/assets/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="/assets/vendor/js/menu.js"></script>

    <!-- Vendors JS -->
    <script src="/assets/vendor/libs/tagify/tagify.js"></script>
    <script src="/assets/vendor/libs/sweetalert2/sweetalert2.js"></script>

    <!-- TinyMCE -->
    <script src="https://cdn.tiny.cloud/1/<%= tinymceApiKey %>/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

    <!-- Main JS -->
    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/token-manager.js"></script>
    <script src="/assets/js/auth-guard.js"></script>

    <!-- Page specific JS -->
    <script>
        let tagify;
        let tinymceInitialized = false;

        $(document).ready(function () {
            // Initialize Tagify for keywords
            const keywordsInput = document.querySelector('#metaKeywords');
            tagify = new Tagify(keywordsInput);

            // Initialize TinyMCE
            initializeTinyMCE();

            // Auto-generate slug from title
            $('#title').on('input', function () {
                const title = $(this).val();
                const slug = generateSlug(title);
                $('#slug').val(slug);
            });

            // Meta description character counter
            $('#metaDescription').on('input', function () {
                const length = $(this).val().length;
                $('#metaDescLength').text(length);
            });
        });

        // Generate slug from title
        function generateSlug(text) {
            return text
                .toLowerCase()
                .trim()
                .replace(/[^\w\s-]/g, '')
                .replace(/[\s_-]+/g, '-')
                .replace(/^-+|-+$/g, '');
        }

        // Initialize TinyMCE
        function initializeTinyMCE() {
            tinymce.init({
                selector: '#content',
                height: 500,
                menubar: true,
                plugins: [
                    'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
                    'anchor', 'searchreplace', 'visualblocks', 'code', 'fullscreen',
                    'insertdatetime', 'media', 'table', 'help', 'wordcount'
                ],
                toolbar: 'undo redo | blocks | ' +
                    'bold italic forecolor | alignleft aligncenter ' +
                    'alignright alignjustify | bullist numlist outdent indent | ' +
                    'removeformat | link image | code | help',
                content_style: 'body { font-family:Helvetica,Arial,sans-serif; font-size:14px }',
                setup: function (editor) {
                    editor.on('init', function () {
                        tinymceInitialized = true;
                    });
                }
            });
        }

        // Form submission
        document.getElementById('addPageForm').addEventListener('submit', async function (event) {
            event.preventDefault();

            // Get TinyMCE content
            if (tinymceInitialized) {
                const content = tinymce.get('content').getContent();
                document.getElementById('content').value = content;
            }

            const form = event.target;
            const formData = new FormData(form);

            // Handle keywords from Tagify
            if (tagify && tagify.value) {
                const keywordsArray = tagify.value.map(tag => tag.value);
                formData.set('metaKeywords', JSON.stringify(keywordsArray));
            } else {
                formData.set('metaKeywords', JSON.stringify([]));
            }

            // Handle checkbox
            const isInMenuCheckbox = document.getElementById('isInMenu');
            formData.set('isInMenu', isInMenuCheckbox.checked);

            // Convert FormData to JSON
            const data = {};
            formData.forEach((value, key) => {
                if (key === 'metaKeywords') {
                    data[key] = JSON.parse(value);
                } else if (key === 'isInMenu') {
                    data[key] = value === 'true' || value === true;
                } else if (key === 'order') {
                    data[key] = parseInt(value) || 0;
                } else {
                    data[key] = value;
                }
            });

            try {
                const response = await fetch('/admin/pages/api/pages', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: 'Page added successfully!',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        window.location.href = '/view-pages';
                    });
                } else {
                    const error = await response.json();
                    let errorMessage = error.error || error.message || 'Failed to add page.';
                    if (error.details && Array.isArray(error.details)) {
                        errorMessage += '\n\nDetails:\n' + error.details.join('\n');
                    }

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: errorMessage,
                        confirmButtonText: 'OK'
                    });
                }
            } catch (err) {
                console.error('Error adding page:', err);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An unexpected error occurred: ' + err.message,
                    confirmButtonText: 'OK'
                });
            }
        });
    </script>

</body>

</html>
