<!doctype html>
<html lang="en" class="layout-navbar-fixed layout-menu-fixed layout-compact" dir="ltr" data-skin="default"
    data-bs-theme="light" data-assets-path="/assets/" data-template="vertical-menu-template">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Manage Pages - Bzz Co.</title>
    <meta name="description" content="" />
    <%- include("layout/header") %>
</head>

<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include("layout/sidebar") %>
            <div class="layout-page">
                <%- include("layout/header") %>
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">

                        <!-- Statistics Cards -->
                        <div class="row mb-4">
                            <div class="col-xl-3 col-md-6 mb-4">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between">
                                            <div class="card-info">
                                                <p class="card-text">Total Pages</p>
                                                <div class="d-flex align-items-end mb-2">
                                                    <h4 class="card-title mb-0 me-2" id="totalPages">0</h4>
                                                </div>
                                            </div>
                                            <div class="card-icon">
                                                <span class="badge bg-label-primary rounded p-2">
                                                    <i class="icon-base ri ri-file-text-line icon-24px"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6 mb-4">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between">
                                            <div class="card-info">
                                                <p class="card-text">Published</p>
                                                <div class="d-flex align-items-end mb-2">
                                                    <h4 class="card-title mb-0 me-2" id="publishedPages">0</h4>
                                                </div>
                                            </div>
                                            <div class="card-icon">
                                                <span class="badge bg-label-success rounded p-2">
                                                    <i class="icon-base ri ri-check-line icon-24px"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6 mb-4">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between">
                                            <div class="card-info">
                                                <p class="card-text">Drafts</p>
                                                <div class="d-flex align-items-end mb-2">
                                                    <h4 class="card-title mb-0 me-2" id="draftPages">0</h4>
                                                </div>
                                            </div>
                                            <div class="card-icon">
                                                <span class="badge bg-label-warning rounded p-2">
                                                    <i class="icon-base ri ri-draft-line icon-24px"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6 mb-4">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between">
                                            <div class="card-info">
                                                <p class="card-text">In Menu</p>
                                                <div class="d-flex align-items-end mb-2">
                                                    <h4 class="card-title mb-0 me-2" id="menuPages">0</h4>
                                                </div>
                                            </div>
                                            <div class="card-icon">
                                                <span class="badge bg-label-info rounded p-2">
                                                    <i class="icon-base ri ri-menu-line icon-24px"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Pages Table -->
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0">All Pages</h5>
                                <a href="/admin/pages/add-page" class="btn btn-primary">
                                    <i class="icon-base ri ri-add-line me-1"></i> Add New Page
                                </a>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="pagesTable" class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <input type="checkbox" class="form-check-input" id="selectAll">
                                                </th>
                                                <th>Title</th>
                                                <th>Slug</th>
                                                <th>Type</th>
                                                <th>Status</th>
                                                <th>In Menu</th>
                                                <th>Created</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-danger" id="bulkDeleteBtn" style="display: none;">
                                        <i class="icon-base ri ri-delete-bin-line me-1"></i> Delete Selected
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>
                    <%- include("layout/footer") %>
                    <div class="content-backdrop fade"></div>
                </div>
            </div>
        </div>
        <div class="layout-overlay layout-menu-toggle"></div>
        <div class="drag-target"></div>
    </div>

    <script src="/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="/assets/vendor/libs/popper/popper.js"></script>
    <script src="/assets/vendor/js/bootstrap.js"></script>
    <script src="/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/assets/vendor/js/menu.js"></script>
    <script src="/assets/js/main.js"></script>

    <script>
        $(document).ready(function () {
            let selectedPages = [];

            // Load statistics
            $.get('/admin/pages/api/pages/stats', function (response) {
                if (response.success) {
                    $('#totalPages').text(response.stats.total);
                    $('#publishedPages').text(response.stats.published);
                    $('#draftPages').text(response.stats.draft);
                    $('#menuPages').text(response.stats.inMenu);
                }
            });

            // Initialize DataTable
            const table = $('#pagesTable').DataTable({
                ajax: {
                    url: '/admin/pages/api/pages',
                    dataSrc: 'pages'
                },
                columns: [
                    {
                        data: '_id',
                        orderable: false,
                        render: function (data) {
                            return `<input type="checkbox" class="form-check-input page-checkbox" value="${data}">`;
                        }
                    },
                    { data: 'title' },
                    {
                        data: 'slug',
                        render: function (data) {
                            return `<code>/${data}</code>`;
                        }
                    },
                    {
                        data: 'pageType',
                        render: function (data) {
                            const badges = {
                                'legal': 'bg-label-primary',
                                'help': 'bg-label-info',
                                'general': 'bg-label-secondary'
                            };
                            return `<span class="badge ${badges[data] || 'bg-label-secondary'}">${data}</span>`;
                        }
                    },
                    {
                        data: 'status',
                        render: function (data) {
                            const badges = {
                                'published': 'bg-label-success',
                                'draft': 'bg-label-warning',
                                'archived': 'bg-label-secondary'
                            };
                            return `<span class="badge ${badges[data]}">${data}</span>`;
                        }
                    },
                    {
                        data: 'isInMenu',
                        render: function (data) {
                            return data ? '<i class="icon-base ri ri-check-line text-success"></i>' :
                                '<i class="icon-base ri ri-close-line text-muted"></i>';
                        }
                    },
                    {
                        data: 'createdAt',
                        render: function (data) {
                            return new Date(data).toLocaleDateString();
                        }
                    },
                    {
                        data: '_id',
                        orderable: false,
                        render: function (data, type, row) {
                            return `
                                <div class="d-flex gap-2">
                                    <a href="/admin/pages/edit-page/${data}" class="btn btn-sm btn-icon btn-text-secondary rounded-pill" title="Edit">
                                        <i class="icon-base ri ri-edit-box-line"></i>
                                    </a>
                                    <a href="/${row.slug}" target="_blank" class="btn btn-sm btn-icon btn-text-secondary rounded-pill" title="View">
                                        <i class="icon-base ri ri-external-link-line"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-icon btn-text-secondary rounded-pill delete-page" data-id="${data}" title="Delete">
                                        <i class="icon-base ri ri-delete-bin-line"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ],
                order: [[6, 'desc']],
                pageLength: 25
            });

            // Handle select all checkbox
            $('#selectAll').on('change', function () {
                const isChecked = $(this).is(':checked');
                $('.page-checkbox').prop('checked', isChecked);
                updateSelectedPages();
            });

            // Handle individual checkbox
            $(document).on('change', '.page-checkbox', updateSelectedPages);

            function updateSelectedPages() {
                selectedPages = [];
                $('.page-checkbox:checked').each(function () {
                    selectedPages.push($(this).val());
                });
                $('#bulkDeleteBtn').toggle(selectedPages.length > 0);
            }

            // Bulk delete
            $('#bulkDeleteBtn').on('click', function () {
                if (selectedPages.length === 0) return;

                Swal.fire({
                    title: 'Delete Selected Pages?',
                    text: `You are about to delete ${selectedPages.length} page(s). This action cannot be undone.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete them!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/admin/pages/api/pages/bulk-delete',
                            method: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ ids: selectedPages }),
                            success: function (response) {
                                Swal.fire('Deleted!', response.message, 'success');
                                table.ajax.reload();
                                selectedPages = [];
                                $('#selectAll').prop('checked', false);
                                $('#bulkDeleteBtn').hide();
                                loadStats();
                            },
                            error: function () {
                                Swal.fire('Error!', 'Failed to delete pages', 'error');
                            }
                        });
                    }
                });
            });

            // Delete single page
            $(document).on('click', '.delete-page', function () {
                const pageId = $(this).data('id');

                Swal.fire({
                    title: 'Delete Page?',
                    text: 'This action cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/admin/pages/api/pages/${pageId}`,
                            method: 'DELETE',
                            success: function (response) {
                                Swal.fire('Deleted!', response.message, 'success');
                                table.ajax.reload();
                                loadStats();
                            },
                            error: function () {
                                Swal.fire('Error!', 'Failed to delete page', 'error');
                            }
                        });
                    }
                });
            });

            function loadStats() {
                $.get('/admin/pages/api/pages/stats', function (response) {
                    if (response.success) {
                        $('#totalPages').text(response.stats.total);
                        $('#publishedPages').text(response.stats.published);
                        $('#draftPages').text(response.stats.draft);
                        $('#menuPages').text(response.stats.inMenu);
                    }
                });
            }
        });
    </script>
</body>

</html>
