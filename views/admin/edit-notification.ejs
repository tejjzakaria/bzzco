<!doctype html>
<html lang="en" class="layout-navbar-fixed layout-menu-fixed layout-compact" dir="ltr" data-skin="default"
    data-bs-theme="light" data-assets-path="/assets/" data-template="vertical-menu-template">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Edit Notification - Bzz Co.</title>
    <meta name="description" content="" />
    <%- include("layout/header") %>
</head>

<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include("layout/sidebar") %>
            <div class="layout-page">
                <%- include("layout/header") %>
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">

                        <!-- Back Button -->
                        <div class="mb-4">
                            <a href="/view-notifications" class="btn btn-sm btn-secondary">
                                <i class="icon-base ri ri-arrow-left-line me-1"></i> Back to Notifications
                            </a>
                        </div>

                        <!-- Edit Notification Form -->
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Edit Notification</h5>
                            </div>
                            <div class="card-body">
                                <form id="notificationForm">
                                    <div class="row">
                                        <!-- Title -->
                                        <div class="col-md-6 mb-4">
                                            <label class="form-label" for="title">Title <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="title" name="title"
                                                placeholder="Notification title" maxlength="100" required>
                                            <div class="form-text">Maximum 100 characters</div>
                                        </div>

                                        <!-- Type -->
                                        <div class="col-md-6 mb-4">
                                            <label class="form-label" for="type">Type <span class="text-danger">*</span></label>
                                            <select class="form-select" id="type" name="type" required>
                                                <option value="info">Info</option>
                                                <option value="success">Success</option>
                                                <option value="warning">Warning</option>
                                                <option value="error">Error</option>
                                                <option value="announcement">Announcement</option>
                                            </select>
                                        </div>

                                        <!-- Message -->
                                        <div class="col-12 mb-4">
                                            <label class="form-label" for="message">Message <span class="text-danger">*</span></label>
                                            <textarea class="form-control" id="message" name="message" rows="4"
                                                placeholder="Notification message..." maxlength="500" required></textarea>
                                            <div class="form-text">Maximum 500 characters</div>
                                        </div>

                                        <!-- Target Audience -->
                                        <div class="col-md-4 mb-4">
                                            <label class="form-label" for="targetAudience">Target Audience <span class="text-danger">*</span></label>
                                            <select class="form-select" id="targetAudience" name="targetAudience" required>
                                                <option value="all">All Users</option>
                                                <option value="admin">Admins Only</option>
                                                <option value="seller">Sellers Only</option>
                                                <option value="customer">Customers Only</option>
                                            </select>
                                        </div>

                                        <!-- Priority -->
                                        <div class="col-md-4 mb-4">
                                            <label class="form-label" for="priority">Priority</label>
                                            <select class="form-select" id="priority" name="priority">
                                                <option value="low">Low</option>
                                                <option value="medium">Medium</option>
                                                <option value="high">High</option>
                                                <option value="urgent">Urgent</option>
                                            </select>
                                        </div>

                                        <!-- Status -->
                                        <div class="col-md-4 mb-4">
                                            <label class="form-label" for="status">Status</label>
                                            <select class="form-select" id="status" name="status">
                                                <option value="active">Active</option>
                                                <option value="inactive">Inactive</option>
                                                <option value="scheduled">Scheduled</option>
                                            </select>
                                        </div>

                                        <!-- Icon -->
                                        <div class="col-md-6 mb-4">
                                            <label class="form-label" for="icon">Icon (RemixIcon class)</label>
                                            <input type="text" class="form-control" id="icon" name="icon"
                                                placeholder="ri-notification-line">
                                            <div class="form-text">
                                                Find icons at <a href="https://remixicon.com" target="_blank">remixicon.com</a>
                                            </div>
                                        </div>

                                        <!-- Icon Preview -->
                                        <div class="col-md-6 mb-4">
                                            <label class="form-label">Icon Preview</label>
                                            <div class="border rounded p-3">
                                                <i class="icon-base ri ri-notification-line icon-48px" id="iconPreview"></i>
                                            </div>
                                        </div>

                                        <!-- Action URL -->
                                        <div class="col-md-6 mb-4">
                                            <label class="form-label" for="actionUrl">Action URL (optional)</label>
                                            <input type="text" class="form-control" id="actionUrl" name="actionUrl"
                                                placeholder="/view-orders">
                                            <div class="form-text">Link when notification is clicked</div>
                                        </div>

                                        <!-- Action Text -->
                                        <div class="col-md-6 mb-4">
                                            <label class="form-label" for="actionText">Action Button Text (optional)</label>
                                            <input type="text" class="form-control" id="actionText" name="actionText"
                                                placeholder="View Details" maxlength="50">
                                        </div>

                                        <!-- Scheduled For -->
                                        <div class="col-md-6 mb-4" id="scheduledForContainer">
                                            <label class="form-label" for="scheduledFor">Schedule For</label>
                                            <input type="datetime-local" class="form-control" id="scheduledFor" name="scheduledFor">
                                            <div class="form-text">When to activate this notification</div>
                                        </div>

                                        <!-- Expires At -->
                                        <div class="col-md-6 mb-4">
                                            <label class="form-label" for="expiresAt">Expires At (optional)</label>
                                            <input type="datetime-local" class="form-control" id="expiresAt" name="expiresAt">
                                            <div class="form-text">Auto-expire after this date</div>
                                        </div>

                                        <!-- Submit Buttons -->
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="icon-base ri ri-save-line me-1"></i> Update Notification
                                            </button>
                                            <a href="/view-notifications" class="btn btn-secondary ms-2">Cancel</a>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                    </div>
                    <div class="content-backdrop fade"></div>
                </div>
            </div>
        </div>
        <div class="layout-overlay layout-menu-toggle"></div>
        <div class="drag-target"></div>
    </div>

    <%- include("layout/footer") %>

    <script>
        const notificationId = '<%= notificationId %>';

        $(document).ready(function () {
            // Load notification data
            loadNotificationData();

            // Icon preview
            $('#icon').on('input', function () {
                const iconClass = $(this).val() || 'ri-notification-line';
                $('#iconPreview').attr('class', `icon-base ri ${iconClass} icon-48px`);
            });

            // Show/hide scheduled for based on status
            $('#status').on('change', function () {
                if ($(this).val() === 'scheduled') {
                    $('#scheduledForContainer').show();
                    $('#scheduledFor').prop('required', true);
                } else {
                    $('#scheduledForContainer').hide();
                    $('#scheduledFor').prop('required', false);
                }
            });

            // Form submission
            $('#notificationForm').on('submit', async function (e) {
                e.preventDefault();

                const formData = {
                    title: $('#title').val(),
                    message: $('#message').val(),
                    type: $('#type').val(),
                    targetAudience: $('#targetAudience').val(),
                    priority: $('#priority').val(),
                    status: $('#status').val(),
                    icon: $('#icon').val(),
                    actionUrl: $('#actionUrl').val(),
                    actionText: $('#actionText').val(),
                    scheduledFor: $('#scheduledFor').val() || null,
                    expiresAt: $('#expiresAt').val() || null
                };

                try {
                    const response = await window.tokenManager.makeAuthenticatedRequest(`/api/notifications/${notificationId}`, {
                        method: 'PUT',
                        body: JSON.stringify(formData)
                    });

                    const result = await response.json();

                    if (result.success) {
                        Swal.fire({
                            title: 'Success!',
                            text: result.message,
                            icon: 'success',
                            confirmButtonText: 'Go to Notifications'
                        }).then(() => {
                            window.location.href = '/view-notifications';
                        });
                    } else {
                        Swal.fire('Error!', result.message || 'Failed to update notification', 'error');
                    }
                } catch (error) {
                    Swal.fire('Error!', 'An error occurred while updating the notification', 'error');
                }
            });
        });

        async function loadNotificationData() {
            try {
                const response = await window.tokenManager.makeAuthenticatedRequest(`/api/notifications/${notificationId}`);
                const result = await response.json();

                if (result.success) {
                    const notif = result.notification;

                    // Populate form fields
                    $('#title').val(notif.title);
                    $('#message').val(notif.message);
                    $('#type').val(notif.type);
                    $('#targetAudience').val(notif.targetAudience);
                    $('#priority').val(notif.priority);
                    $('#status').val(notif.status);
                    $('#icon').val(notif.icon || 'ri-notification-line');
                    $('#actionUrl').val(notif.actionUrl || '');
                    $('#actionText').val(notif.actionText || '');

                    // Format dates for datetime-local input
                    if (notif.scheduledFor) {
                        const scheduleDate = new Date(notif.scheduledFor);
                        $('#scheduledFor').val(scheduleDate.toISOString().slice(0, 16));
                    }
                    if (notif.expiresAt) {
                        const expiryDate = new Date(notif.expiresAt);
                        $('#expiresAt').val(expiryDate.toISOString().slice(0, 16));
                    }

                    // Update icon preview
                    const iconClass = notif.icon || 'ri-notification-line';
                    $('#iconPreview').attr('class', `icon-base ri ${iconClass} icon-48px`);

                    // Show/hide scheduled container
                    if (notif.status === 'scheduled') {
                        $('#scheduledForContainer').show();
                    }
                } else {
                    Swal.fire('Error!', 'Failed to load notification data', 'error');
                }
            } catch (error) {
                Swal.fire('Error!', 'An error occurred while loading the notification', 'error');
            }
        }
    </script>
</body>

</html>
