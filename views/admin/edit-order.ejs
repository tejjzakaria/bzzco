<!doctype html>

<html lang="en" class="layout-navbar-fixed layout-menu-fixed layout-compact" dir="ltr" data-skin="default"
    data-bs-theme="light" data-assets-path="/assets/" data-template="vertical-menu-template">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Edit Order - Bzz Co.</title>

    <meta name="description" content="" />
    <%- include("layout/header") %>
</head>

<body>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu -->
            <%- include("layout/sidebar") %>

                <div class="menu-mobile-toggler d-xl-none rounded-1">
                    <a href="javascript:void(0);"
                        class="layout-menu-toggle menu-link text-large text-bg-secondary p-2 rounded-1">
                        <i class="ri ri-menu-line icon-base"></i>
                        <i class="ri ri-arrow-right-s-line icon-base"></i>
                    </a>
                </div>
                <!-- / Menu -->

                <!-- Layout container -->
                <div class="layout-page">
                    <!-- Navbar -->
                    <%- include("layout/header") %>
                        <!-- / Navbar -->

                        <!-- Content wrapper -->
                        <div class="content-wrapper">
                            <!-- Content -->
                            <div class="container-xxl flex-grow-1 container-p-y">
                                <div class="app-ecommerce">
                                    <!-- Edit Order -->
                                    <div
                                        class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
                                        <div class="d-flex flex-column justify-content-center">
                                            <h4 class="mb-1">Edit Order #<%= order.order_number %></h4>
                                            <p class="mb-0">Update the order details</p>
                                        </div>
                                        <div class="d-flex align-content-center flex-wrap gap-4">
                                            <button type="button" class="btn btn-outline-secondary"
                                                onclick="window.location.href='/view-orders'">Cancel</button>
                                            <button type="submit" form="editOrderForm" class="btn btn-primary">Update
                                                Order</button>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <!-- Order Form -->
                                        <div class="col-12 col-lg-8">
                                            <div class="card mb-6">
                                                <div class="card-header">
                                                    <h5 class="card-title mb-0">Order Information</h5>
                                                </div>
                                                <div class="card-body">
                                                    <form id="editOrderForm" data-product-count="<%= order.products ? order.products.length : 0 %>">
                                                        <input type="hidden" id="order_id" name="order_id" value="<%= order._id %>">
                                                        
                                                        <div class="row">
                                                            <div class="col-md-4 mb-6">
                                                                <label class="form-label" for="order_number">Order
                                                                    Number</label>
                                                                <input type="text" class="form-control"
                                                                    id="order_number" name="order_number"
                                                                    value="<%= order.order_number %>" readonly />
                                                                <small class="form-text text-muted">Order number cannot be changed</small>
                                                            </div>
                                                            <div class="col-md-4 mb-6">
                                                                <label class="form-label" for="status">Order
                                                                    Status</label>
                                                                <select class="form-select" id="status" name="status" required>
                                                                    <option value="Pending" <%= order.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                                                    <option value="Processing" <%= order.status === 'Processing' ? 'selected' : '' %>>Processing</option>
                                                                    <option value="Shipped" <%= order.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                                                                    <option value="Delivered" <%= order.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                                                                    <option value="Cancelled" <%= order.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-md-4 mb-6">
                                                                <label class="form-label" for="payment_status">Payment Status</label>
                                                                <select class="form-select" id="payment_status" name="payment_status" required>
                                                                    <option value="Unpaid" <%= order.payment_status === 'Unpaid' ? 'selected' : '' %>>Unpaid</option>
                                                                    <option value="Paid" <%= order.payment_status === 'Paid' ? 'selected' : '' %>>Paid</option>
                                                                    <option value="Pending" <%= order.payment_status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                                                    <option value="Failed" <%= order.payment_status === 'Failed' ? 'selected' : '' %>>Failed</option>
                                                                    <option value="Refunded" <%= order.payment_status === 'Refunded' ? 'selected' : '' %>>Refunded</option>
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <!-- Customer Information (Read-only) -->
                                                        <div class="row">
                                                            <div class="col-12 mb-6">
                                                                <h6 class="text-body">Customer Information</h6>
                                                                <div class="alert alert-info">
                                                                    <% if (order.customer_type === 'guest') { %>
                                                                        <strong>Guest Customer:</strong> <%= order.guest_name %><br>
                                                                        <strong>Email:</strong> <%= order.guest_email %><br>
                                                                        <% if (order.guest_phone) { %>
                                                                            <strong>Phone:</strong> <%= order.guest_phone %>
                                                                        <% } %>
                                                                    <% } else if (order.customer_id) { %>
                                                                        <strong>Registered Customer:</strong> <%= order.customer_id.full_name %><br>
                                                                        <strong>Email:</strong> <%= order.customer_id.email %>
                                                                    <% } else { %>
                                                                        <strong>Unknown Customer</strong>
                                                                    <% } %>
                                                                </div>
                                                                <small class="form-text text-muted">Customer information cannot be changed</small>
                                                            </div>
                                                        </div>

                                                        <!-- Payment Method -->
                                                        <div class="row">
                                                            <div class="col-md-6 mb-6">
                                                                <label class="form-label" for="payment_method">Payment Method</label>
                                                                <select class="form-select" id="payment_method" name="payment_method" required>
                                                                    <option value="Credit Card" <%= order.payment_method === 'Credit Card' ? 'selected' : '' %>>Credit Card</option>
                                                                    <option value="Debit Card" <%= order.payment_method === 'Debit Card' ? 'selected' : '' %>>Debit Card</option>
                                                                    <option value="PayPal" <%= order.payment_method === 'PayPal' ? 'selected' : '' %>>PayPal</option>
                                                                    <option value="Bank Transfer" <%= order.payment_method === 'Bank Transfer' ? 'selected' : '' %>>Bank Transfer</option>
                                                                    <option value="Cash on Delivery" <%= order.payment_method === 'Cash on Delivery' ? 'selected' : '' %>>Cash on Delivery</option>
                                                                </select>
                                                            </div>
                                                        </div>


                                                        <div class="row">
                                                            <div class="col-12 mb-6">
                                                                <label class="form-label">Products</label>
                                                                <div class="card">
                                                                    <div
                                                                        class="card-header d-flex justify-content-between align-items-center">
                                                                        <h6 class="mb-0">Order Items</h6>
                                                                        <button type="button"
                                                                            class="btn btn-sm btn-primary"
                                                                            id="addProductBtn">
                                                                            <i class="ri-add-line me-1"></i>Add Product
                                                                        </button>
                                                                    </div>
                                                                    <div class="card-body">
                                                                        <div id="productsList">
                                                                            <!-- Existing products from order -->
                                                                            <% if (order.products && order.products.length > 0) { %>
                                                                                <% order.products.forEach((item, index) => { %>
                                                                                    <div class="product-item border rounded p-3 mb-3" data-index="<%= index %>">
                                                                                        <div class="row align-items-end">
                                                                                            <div class="col-md-5 mb-3">
                                                                                                <label class="form-label">Product</label>
                                                                                                <select class="form-select product-select" name="products[<%= index %>][product_id]" required>
                                                                                                    <option value="">Select Product</option>
                                                                                                    <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
                                                                                                        <% products.forEach(product => { %>
                                                                                                            <%
                                                                                                                let isSelected = false;
                                                                                                                if (item.product_id) {
                                                                                                                    const itemProductId = item.product_id._id ? item.product_id._id.toString() : item.product_id.toString();
                                                                                                                    const productId = product._id.toString();
                                                                                                                    isSelected = itemProductId === productId;
                                                                                                                }
                                                                                                            %>
                                                                                                            <option value="<%= product._id %>" 
                                                                                                                    data-price="<%= product.productPrice %>" 
                                                                                                                    <%= isSelected ? 'selected' : '' %>>
                                                                                                                <%= product.productTitle %> - $<%= product.productPrice %>
                                                                                                            </option>
                                                                                                        <% }); %>
                                                                                                    <% } else { %>
                                                                                                        <option disabled>No products available</option>
                                                                                                    <% } %>
                                                                                                </select>
                                                                                            </div>
                                                                                            <div class="col-md-2 mb-3">
                                                                                                <label class="form-label">Quantity</label>
                                                                                                <input type="number" class="form-control quantity-input" 
                                                                                                       name="products[<%= index %>][quantity]" 
                                                                                                       placeholder="1" min="1" 
                                                                                                       value="<%= item.quantity %>" required />
                                                                                            </div>
                                                                                            <div class="col-md-3 mb-3">
                                                                                                <label class="form-label">Unit Price</label>
                                                                                                <div class="input-group">
                                                                                                    <span class="input-group-text">$</span>
                                                                                                    <input type="number" class="form-control unit-price-input" 
                                                                                                           name="products[<%= index %>][unit_price]" 
                                                                                                           placeholder="0.00" min="0" step="0.01" 
                                                                                                           value="<%= item.unit_price %>" required />
                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="col-md-2 mb-3">
                                                                                                <button type="button" class="btn btn-outline-danger btn-sm remove-product-btn" 
                                                                                                        style="height: 48px;">
                                                                                                    <i class="ri ri-delete-bin-line"></i>
                                                                                                </button>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="row">
                                                                                            <div class="col-12">
                                                                                                <small class="text-muted">
                                                                                                    Subtotal: $<span class="item-subtotal"><%= (item.quantity * item.unit_price).toFixed(2) %></span>
                                                                                                </small>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                <% }); %>
                                                                            <% } else { %>
                                                                                <!-- If no products, show empty row -->
                                                                                <div class="product-item border rounded p-3 mb-3" data-index="0">
                                                                                    <div class="row align-items-end">
                                                                                        <div class="col-md-5 mb-3">
                                                                                            <label class="form-label">Product</label>
                                                                                            <select class="form-select product-select" name="products[0][product_id]" required>
                                                                                                <option value="">Select Product</option>
                                                                                                <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
                                                                                                    <% products.forEach(product => { %>
                                                                                                        <option value="<%= product._id %>" data-price="<%= product.productPrice %>">
                                                                                                            <%= product.productTitle %> - $<%= product.productPrice %>
                                                                                                        </option>
                                                                                                    <% }); %>
                                                                                                <% } else { %>
                                                                                                    <option disabled>No products available</option>
                                                                                                <% } %>
                                                                                            </select>
                                                                                        </div>
                                                                                        <div class="col-md-2 mb-3">
                                                                                            <label class="form-label">Quantity</label>
                                                                                            <input type="number" class="form-control quantity-input" 
                                                                                                   name="products[0][quantity]" 
                                                                                                   placeholder="1" min="1" value="1" required />
                                                                                        </div>
                                                                                        <div class="col-md-3 mb-3">
                                                                                            <label class="form-label">Unit Price</label>
                                                                                            <div class="input-group">
                                                                                                <span class="input-group-text">$</span>
                                                                                                <input type="number" class="form-control unit-price-input" 
                                                                                                       name="products[0][unit_price]" 
                                                                                                       placeholder="0.00" min="0" step="0.01" required />
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="col-md-2 mb-3">
                                                                                            <button type="button" class="btn btn-outline-danger btn-sm remove-product-btn" 
                                                                                                    style="display: none; height: 48px;">
                                                                                                <i class="ri ri-delete-bin-line"></i>
                                                                                            </button>
                                                                                        </div>
                                                                                    </div>
                                                                                    <div class="row">
                                                                                        <div class="col-12">
                                                                                            <small class="text-muted">
                                                                                                Subtotal: $<span class="item-subtotal">0.00</span>
                                                                                            </small>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            <% } %>
                                                                        </div>

                                                                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                                                            <strong>Total Amount: $<span id="orderTotal"><%= order.total_price ? order.total_price.toFixed(2) : '0.00' %></span></strong>
                                                                            <small class="text-muted"><span id="totalItems"><%= order.products ? order.products.length : 0 %></span> item(s)</small>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        

                                                        <div class="row">
                                                            <!-- Shipping Address -->
                                                            <div class="col-md-6 mb-6">
                                                                <h6 class="mb-3">Shipping Address</h6>
                                                                
                                                                <div class="mb-3">
                                                                    <label class="form-label" for="shipping_street">Street Address</label>
                                                                    <input type="text" class="form-control" id="shipping_street"
                                                                        name="shipping_address[street]" 
                                                                        placeholder="Enter street address"
                                                                        value="<%= order.shipping_address && order.shipping_address.street ? order.shipping_address.street : '' %>" required>
                                                                </div>
                                                                
                                                                <div class="row">
                                                                    <div class="col-md-6 mb-3">
                                                                        <label class="form-label" for="shipping_city">City</label>
                                                                        <input type="text" class="form-control" id="shipping_city"
                                                                            name="shipping_address[city]" 
                                                                            placeholder="Enter city"
                                                                            value="<%= order.shipping_address && order.shipping_address.city ? order.shipping_address.city : '' %>" required>
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label class="form-label" for="shipping_postal_code">Postal Code</label>
                                                                        <input type="text" class="form-control" id="shipping_postal_code"
                                                                            name="shipping_address[postal_code]" 
                                                                            placeholder="Enter postal code"
                                                                            value="<%= order.shipping_address && order.shipping_address.postal_code ? order.shipping_address.postal_code : '' %>" required>
                                                                    </div>
                                                                </div>
                                                                
                                                                <div class="mb-3">
                                                                    <label class="form-label" for="shipping_country">Country</label>
                                                                    <input type="text" class="form-control" id="shipping_country" 
                                                                           name="shipping_address[country]" 
                                                                           placeholder="Enter country"
                                                                           value="<%= order.shipping_address && order.shipping_address.country ? order.shipping_address.country : '' %>" required>
                                                                </div>
                                                            </div>

                                                            <!-- Billing Address -->
                                                            <div class="col-md-6 mb-6">
                                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                                    <h6 class="mb-0">Billing Address</h6>
                                                                    <div class="form-check">
                                                                        <input class="form-check-input" type="checkbox" id="same_as_shipping">
                                                                        <label class="form-check-label" for="same_as_shipping">
                                                                            Same as shipping
                                                                        </label>
                                                                    </div>
                                                                </div>
                                                                
                                                                <div class="mb-3">
                                                                    <label class="form-label" for="billing_street">Street Address</label>
                                                                    <input type="text" class="form-control" id="billing_street"
                                                                        name="billing_address[street]" 
                                                                        placeholder="Enter street address"
                                                                        value="<%= order.billing_address && order.billing_address.street ? order.billing_address.street : '' %>" required>
                                                                </div>
                                                                
                                                                <div class="row">
                                                                    <div class="col-md-6 mb-3">
                                                                        <label class="form-label" for="billing_city">City</label>
                                                                        <input type="text" class="form-control" id="billing_city"
                                                                            name="billing_address[city]" 
                                                                            placeholder="Enter city"
                                                                            value="<%= order.billing_address && order.billing_address.city ? order.billing_address.city : '' %>" required>
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label class="form-label" for="billing_postal_code">Postal Code</label>
                                                                        <input type="text" class="form-control" id="billing_postal_code"
                                                                            name="billing_address[postal_code]" 
                                                                            placeholder="Enter postal code"
                                                                            value="<%= order.billing_address && order.billing_address.postal_code ? order.billing_address.postal_code : '' %>" required>
                                                                    </div>
                                                                </div>
                                                                
                                                                <div class="mb-3">
                                                                    <label class="form-label" for="billing_country">Country</label>
                                                                    <input type="text" class="form-control" id="billing_country" 
                                                                           name="billing_address[country]" 
                                                                           placeholder="Enter country"
                                                                           value="<%= order.billing_address && order.billing_address.country ? order.billing_address.country : '' %>" required>
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Order Summary -->
                                        <div class="col-12 col-lg-4">
                                            <div class="card mb-6">
                                                <div class="card-header">
                                                    <h5 class="card-title mb-0">Order Summary</h5>
                                                </div>
                                                <div class="card-body">
                                                    <div class="d-flex justify-content-between mb-2">
                                                        <span class="w-px-100 text-heading">Customer:</span>
                                                        <span id="summary-customer">
                                                            <% if (order.customer_type === 'guest') { %>
                                                                <%= order.guest_name || 'Guest Customer' %>
                                                            <% } else if (order.customer_id) { %>
                                                                <%= order.customer_id.full_name %>
                                                            <% } else { %>
                                                                Unknown Customer
                                                            <% } %>
                                                        </span>
                                                    </div>
                                                    <div class="d-flex justify-content-between mb-2">
                                                        <span class="w-px-100 text-heading">Items:</span>
                                                        <span id="summary-items"><%= order.products ? order.products.length : 0 %> items</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between mb-2">
                                                        <span class="w-px-100 text-heading">Status:</span>
                                                        <span id="summary-status"><%= order.status || 'Pending' %></span>
                                                    </div>
                                                    <hr class="my-4">
                                                    <div class="d-flex justify-content-between">
                                                        <span class="w-px-100 text-heading">Total:</span>
                                                        <span class="fw-medium" id="summary-total">$<%= order.total_price ? order.total_price.toFixed(2) : '0.00' %></span>
                                                    </div>

                                                    <div class="mt-3">
                                                        <h6 class="mb-2">Products:</h6>
                                                        <div id="summary-products">
                                                            <% if (order.products && order.products.length > 0) { %>
                                                                <% order.products.forEach(item => { %>
                                                                    <small class="d-block text-muted">
                                                                        • <%= item.product_id ? item.product_id.productTitle : 'Unknown Product' %> (x<%= item.quantity %>)
                                                                    </small>
                                                                <% }); %>
                                                            <% } else { %>
                                                                <small class="text-muted">No products selected</small>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="card">
                                                <div class="card-header">
                                                    <h5 class="card-title mb-0">Edit Notes</h5>
                                                </div>
                                                <div class="card-body">
                                                    <p class="card-text">
                                                        <small class="text-muted">
                                                            • Order number cannot be changed<br>
                                                            • Customer information cannot be modified<br>
                                                            • Update product quantities and prices as needed<br>
                                                            • Total price will be recalculated automatically
                                                        </small>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- / Content -->
                        </div>
                        <!-- / Content wrapper -->

                        <%- include("layout/footer") %>

                            <div class="content-backdrop fade"></div>
                </div>
                <!-- Content wrapper -->
        </div>
        <!-- / Layout page -->
    </div>

    <!-- Overlay -->
    <div class="layout-overlay layout-menu-toggle"></div>

    <!-- Drag Target Area To SlideIn Menu On Small Screens -->
    <div class="drag-target"></div>
    </div>
    <!-- / Layout wrapper -->

    <!-- Core JS -->
    <%- include("layout/auth-footer") %>

        <!-- Vendors JS -->
        <script src="/assets/vendor/libs/select2/select2.js"></script>
        <!-- SweetAlert2 -->
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script src="/assets/js/token-manager.js"></script>
    <script src="/assets/js/auth-guard.js"></script>

        <script>
            let productIndex = 1; // Start from 1 since we have index 0 initially

            // Initialize page for editing existing order
            $(document).ready(function () {
                // Set initial product index based on existing products from data attribute
                const existingProductCount = parseInt($('#editOrderForm').data('product-count')) || 0;
                productIndex = existingProductCount > 0 ? existingProductCount : 1;
                
                initializeSelect2Elements();
                setupEventListeners();
                updateOrderSummary();
                updateRemoveButtons();
                
                // Check if billing address matches shipping address on load
                checkAddressesMatch();
            });
            
            function checkAddressesMatch() {
                const shippingStreet = $('#shipping_street').val();
                const billingStreet = $('#billing_street').val();
                const shippingCity = $('#shipping_city').val();
                const billingCity = $('#billing_city').val();
                
                if (shippingStreet === billingStreet && shippingCity === billingCity) {
                    $('#same_as_shipping').prop('checked', true);
                }
            }

            function initializeSelect2Elements() {
                // Initialize status selects
                $('#status').select2({
                    placeholder: 'Select Status',
                    allowClear: false
                });

                $('#payment_method').select2({
                    placeholder: 'Select Payment Method',
                    allowClear: false
                });

                $('#payment_status').select2({
                    placeholder: 'Select Payment Status',
                    allowClear: false
                });

                // Initialize product selects (for existing products)
                $('.product-select').select2({
                    placeholder: 'Select Product',
                    allowClear: true
                });
            }

            function setupEventListeners() {
                // Add product button
                $('#addProductBtn').on('click', addProductRow);

                // Remove product button (delegated event)
                $(document).on('click', '.remove-product-btn', function () {
                    removeProductRow($(this));
                });

                // Product selection change (delegated event)
                $(document).on('change', '.product-select', function () {
                    updateItemSubtotal($(this).closest('.product-item'));
                    updateOrderSummary();
                });

                // Quantity or price change (delegated event)
                $(document).on('input', '.quantity-input, .unit-price-input', function () {
                    updateItemSubtotal($(this).closest('.product-item'));
                    updateOrderSummary();
                });

                // Status change
                $('#status').on('change', function () {
                    updateOrderSummary();
                });

                // Same as shipping checkbox
                $('#same_as_shipping').on('change', function () {
                    if ($(this).is(':checked')) {
                        copyShippingToBilling();
                    }
                });

                // Update billing when shipping changes if "same as shipping" is checked
                $('input[name^="shipping_"], select[name^="shipping_"]').on('input change', function () {
                    if ($('#same_as_shipping').is(':checked')) {
                        copyShippingToBilling();
                    }
                });
            }

            // Copy shipping address to billing address
            function copyShippingToBilling() {
                $('#billing_street').val($('#shipping_street').val());
                $('#billing_city').val($('#shipping_city').val());
                $('#billing_postal_code').val($('#shipping_postal_code').val());
                $('#billing_country').val($('#shipping_country').val()).trigger('change');
            }

            function addProductRow() {
                const productOptions = `
        <option value="">Select Product</option>
        <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
            <% products.forEach(product => { %>
                <option value="<%= product._id %>" data-price="<%= product.productPrice %>">
                    <%= product.productTitle %> - $<%= product.productPrice %>
                </option>
            <% }); %>
        <% } else { %>
            <option disabled>No products available</option>
        <% } %>
    `;

                const newRow = `
        <div class="product-item border rounded p-3 mb-3" data-index="${productIndex}">
            <div class="row align-items-end">
                <div class="col-md-5 mb-3">
                    <label class="form-label">Product</label>
                    <select class="form-select product-select" name="products[${productIndex}][product_id]" required>
                        ${productOptions}
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Quantity</label>
                    <input type="number" class="form-control quantity-input" name="products[${productIndex}][quantity]" placeholder="1" min="1" value="1" required />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Unit Price</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control unit-price-input" name="products[${productIndex}][unit_price]" placeholder="0.00" min="0" step="0.01" required />
                    </div>
                </div>
                <div class="col-md-2 mb-3">
                    <button type="button" class="btn btn-outline-danger btn-sm remove-product-btn" style="height: 48px;">
                        <i class="ri ri-delete-bin-line"></i>
                    </button>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <small class="text-muted">
                        Subtotal: $<span class="item-subtotal">0.00</span>
                    </small>
                </div>
            </div>
        </div>
    `;

                $('#productsList').append(newRow);

                // Initialize Select2 for the new product select
                $(`[name="products[${productIndex}][product_id]"]`).select2({
                    placeholder: 'Select Product',
                    allowClear: true
                });

                productIndex++;
                updateRemoveButtons();
                updateOrderSummary();
            }

            // Add auto-fill price functionality when product is selected
            $(document).on('change', '.product-select', function () {
                const selectedOption = $(this).find('option:selected');
                const price = selectedOption.data('price');
                const $item = $(this).closest('.product-item');

                if (price) {
                    $item.find('.unit-price-input').val(price);
                }

                updateItemSubtotal($item);
                updateOrderSummary();
            });

            function removeProductRow($button) {
                $button.closest('.product-item').remove();
                updateRemoveButtons();
                updateOrderSummary();
            }

            function updateRemoveButtons() {
                const productItems = $('.product-item');
                if (productItems.length > 1) {
                    $('.remove-product-btn').show();
                } else {
                    $('.remove-product-btn').hide();
                }
            }

            function updateItemSubtotal($item) {
                const quantity = parseFloat($item.find('.quantity-input').val()) || 0;
                const unitPrice = parseFloat($item.find('.unit-price-input').val()) || 0;
                const subtotal = quantity * unitPrice;

                $item.find('.item-subtotal').text(subtotal.toFixed(2));
            }

            // Update order summary function (updated for editing existing order)
            function updateOrderSummary() {
                // Customer info is read-only in edit mode, so we don't need to update it
                
                // Update status
                const statusSelect = $('#status');
                const summaryStatus = document.getElementById('summary-status');
                if (statusSelect.val()) {
                    summaryStatus.textContent = statusSelect.find('option:selected').text();
                }

                // Calculate totals and update products summary
                let totalAmount = 0;
                let totalItems = 0;
                let productsSummary = '';

                $('.product-item').each(function () {
                    const $item = $(this);
                    const productSelect = $item.find('.product-select');
                    const quantity = parseFloat($item.find('.quantity-input').val()) || 0;
                    const unitPrice = parseFloat($item.find('.unit-price-input').val()) || 0;
                    const subtotal = quantity * unitPrice;

                    if (productSelect.val() && quantity > 0 && unitPrice > 0) {
                        totalAmount += subtotal;
                        totalItems += quantity;

                        const productName = productSelect.find('option:selected').text();
                        if (productName !== 'Select Product') {
                            productsSummary += `
                            <div class="d-flex justify-content-between mb-1">
                                <small>${productName} (${quantity}x)</small>
                                <small>$${subtotal.toFixed(2)}</small>
                            </div>
                        `;
                        }
                    }

                    // Update individual item subtotal
                    updateItemSubtotal($item);
                });

                // Update summary
                document.getElementById('summary-items').textContent = `${totalItems} item(s)`;
                document.getElementById('summary-total').textContent = '$' + totalAmount.toFixed(2);
                document.getElementById('orderTotal').textContent = totalAmount.toFixed(2);
                document.getElementById('totalItems').textContent = $('.product-item').length;

                // Update products summary
                const summaryProductsDiv = document.getElementById('summary-products');
                if (productsSummary) {
                    summaryProductsDiv.innerHTML = productsSummary;
                } else {
                    summaryProductsDiv.innerHTML = '<small class="text-muted">No products selected</small>';
                }
            }

            document.getElementById('editOrderForm').addEventListener('submit', async function (e) {
                e.preventDefault();

                const orderId = document.getElementById('order_id').value;
                const formData = new FormData(this);
                const orderData = Object.fromEntries(formData);

                // Collect products data for array-based model
                const products = [];
                $('.product-item').each(function () {
                    const $item = $(this);
                    const productId = $item.find('.product-select').val();
                    const quantity = parseInt($item.find('.quantity-input').val()) || 0;
                    const unitPrice = parseFloat($item.find('.unit-price-input').val()) || 0;

                    if (productId && quantity > 0 && unitPrice > 0) {
                        products.push({
                            product_id: productId,
                            quantity: quantity,
                            unit_price: unitPrice,
                            total_price: quantity * unitPrice
                        });
                    }
                });

                // Calculate total order amount
                const totalAmount = products.reduce((sum, product) => sum + product.total_price, 0);

                // Prepare update data (only editable fields)
                const updateData = {
                    products: products,
                    total_price: totalAmount,
                    status: orderData.status,
                    payment_method: orderData.payment_method,
                    payment_status: orderData.payment_status,
                    shipping_address: {
                        street: orderData['shipping_address[street]'],
                        city: orderData['shipping_address[city]'],
                        postal_code: orderData['shipping_address[postal_code]'],
                        country: orderData['shipping_address[country]']
                    },
                    billing_address: {
                        street: orderData['billing_address[street]'],
                        city: orderData['billing_address[city]'],
                        postal_code: orderData['billing_address[postal_code]'],
                        country: orderData['billing_address[country]']
                    }
                };

                // Validate that at least one product is selected
                if (products.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Missing Products',
                        text: 'Please add at least one product to the order.',
                        confirmButtonColor: '#696cff'
                    });
                    return;
                }

                // Validate address fields
                const requiredAddressFields = [
                    { field: 'shipping_address[street]', name: 'Shipping Street Address' },
                    { field: 'shipping_address[city]', name: 'Shipping City' },
                    { field: 'shipping_address[postal_code]', name: 'Shipping Postal Code' },
                    { field: 'shipping_address[country]', name: 'Shipping Country' },
                    { field: 'billing_address[street]', name: 'Billing Street Address' },
                    { field: 'billing_address[city]', name: 'Billing City' },
                    { field: 'billing_address[postal_code]', name: 'Billing Postal Code' },
                    { field: 'billing_address[country]', name: 'Billing Country' }
                ];

                for (const { field, name } of requiredAddressFields) {
                    if (!orderData[field] || orderData[field].trim() === '') {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Missing Address Information',
                            text: `Please fill in the ${name} field.`,
                            confirmButtonColor: '#696cff'
                        });
                        return;
                    }
                }

                // Show confirmation dialog
                const result = await Swal.fire({
                    title: 'Update Order?',
                    text: 'Are you sure you want to update this order?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#696cff',
                    cancelButtonColor: '#8592a3',
                    confirmButtonText: 'Yes, update it!'
                });

                if (!result.isConfirmed) {
                    return;
                }

                // Debug: Log the data being sent
                console.log('Order update data being sent:', updateData);

                try {
                    const response = await fetch(`/api/orders/${orderId}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(updateData)
                    });

                    if (response.ok) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Order Updated!',
                            text: 'Order has been updated successfully!',
                            confirmButtonColor: '#696cff',
                            timer: 2000,
                            timerProgressBar: true
                        }).then(() => {
                            window.location.href = '/view-orders';
                        });
                    } else {
                        const error = await response.json();
                        console.error('Server error response:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Update Failed',
                            text: error.message || 'Unknown error occurred',
                            confirmButtonColor: '#696cff'
                        });
                    }
                } catch (error) {
                    console.error('Network error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Network Error',
                        text: 'Failed to connect to server. Please try again.',
                        confirmButtonColor: '#696cff'
                    });
                }
            });
        </script>
</body>

</html>