                                                        <div class="avatar me-4">
                                                            <div class="avatar-initial bg-label-primary rounded-3">
                                                                <i
                                                                    class="icon-base ri ri-database-2-line icon-24px"></i>
                                                            </div>
                                                        </div>
                                                        <div class="card-info">
                                                            <h5 class="mb-0" id="stat-products">0</h5>
                                                            <p class="mb-0">Products</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="card">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-center flex-wrap">
                                                        <div class="avatar me-4">
                                                            <div class="avatar-initial bg-label-info rounded-3">
                                                                <i class="icon-base ri ri-user-line icon-24px"></i>
                                                            </div>
                                                        </div>
                                                        <div class="card-info">
                                                            <h5 class="mb-0" id="stat-customers">0</h5>
                                                            <p class="mb-0">Customers</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="card">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-center flex-wrap">
                                                        <div class="avatar me-4">
                                                            <div class="avatar-initial bg-label-warning rounded-3">
                                                                <i class="icon-base ri ri-user-star-line icon-24px"></i>
                                                            </div>
                                                        </div>
                                                        <div class="card-info">
                                                            <h5 class="mb-0" id="stat-sellers">0</h5>
                                                            <p class="mb-0">Sellers</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="card">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-center flex-wrap">
                                                        <div class="avatar me-4">
                                                            <div class="avatar-initial bg-label-success rounded-3">
                                                                <i class="icon-base ri ri-store-2-line icon-24px"></i>
                                                            </div>
                                                        </div>
                                                        <div class="card-info">
                                                            <h5 class="mb-0" id="stat-merchants">0</h5>
                                                            <p class="mb-0">Merchants</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="card">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-center flex-wrap">
                                                        <div class="avatar me-4">
                                                            <div class="avatar-initial bg-label-secondary rounded-3">
                                                                <i
                                                                    class="icon-base ri ri-shopping-cart-2-line icon-24px"></i>
                                                            </div>
                                                        </div>
                                                        <div class="card-info">
                                                            <h5 class="mb-0" id="stat-orders">0</h5>
                                                            <p class="mb-0">Orders</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="card">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-center flex-wrap">
                                                        <div class="avatar me-4">
                                                            <div class="avatar-initial bg-label-dark rounded-3">
                                                                <i class="icon-base ri ri-apps-2-line icon-24px"></i>
                                                            </div>
                                                        </div>
                                                        <div class="card-info">
                                                            <h5 class="mb-0" id="stat-categories">0</h5>
                                                            <p class="mb-0">Categories</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="card">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-center flex-wrap">
                                                        <div class="avatar me-4">
                                                            <div class="avatar-initial bg-label-info rounded-3">
                                                                <i class="icon-base ri ri-mail-line icon-24px"></i>
                                                            </div>
                                                        </div>
                                                        <div class="card-info">
                                                            <h5 class="mb-0" id="stat-newsletter">0</h5>
                                                            <p class="mb-0">Newsletter Subs</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="card">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-center flex-wrap">
                                                        <div class="avatar me-4">
                                                            <div class="avatar-initial bg-label-danger rounded-3">
                                                                <i class="icon-base ri ri-message-2-line icon-24px"></i>
                                                            </div>
                                                        </div>
                                                        <div class="card-info">
                                                            <h5 class="mb-0" id="stat-contacts">0</h5>
                                                            <p class="mb-0">Contact Messages</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="card">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-center flex-wrap">
                                                        <div class="avatar me-4">
                                                            <div class="avatar-initial bg-label-warning rounded-3">
                                                                <i
                                                                    class="icon-base ri ri-briefcase-4-line icon-24px"></i>
                                                            </div>
                                                        </div>
                                                        <div class="card-info">
                                                            <h5 class="mb-0" id="stat-job-applications">0</h5>
                                                            <p class="mb-0">Job Applications</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="card">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-center flex-wrap">
                                                        <div class="avatar me-4">
                                                            <div class="avatar-initial bg-label-success rounded-3">
                                                                <i class="icon-base ri ri-team-line icon-24px"></i>
                                                            </div>
                                                        </div>
                                                        <div class="card-info">
                                                            <h5 class="mb-0" id="stat-team">0</h5>
                                                            <p class="mb-0">Team Members</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="card">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-center flex-wrap">
                                                        <div class="avatar me-4">
                                                            <div class="avatar-initial bg-label-primary rounded-3">
                                                                <i
                                                                    class="icon-base ri ri-slideshow-2-line icon-24px"></i>
                                                            </div>
                                                        </div>
                                                        <div class="card-info">
                                                            <h5 class="mb-0" id="stat-sliders">0</h5>
                                                            <p class="mb-0">Sliders</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <!--/ On route vehicles Table -->

                                <!-- Stats Charts Row -->
                                <div class="row g-4 mt-4">
                                    <div class="col-md-6">
                                        <div class="card">
                                            <div class="card-header">
                                                <h5 class="mb-0">Entity Overview</h5>
                                            </div>
                                            <div class="card-body">
                                                <canvas id="statsBarChart" height="200"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card">
                                            <div class="card-header">
                                                <h5 class="mb-0">Other Stats</h5>
                                            </div>
                                            <div class="card-body">
                                                <canvas id="statsDoughnutChart" height="200"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- / Content -->

                            <!-- Footer -->
                            <%- include("layout/footer") %>
                                <!-- / Footer -->

                                <div class="content-backdrop fade"></div>
                        </div>
                        <!-- Content wrapper -->
                </div>
                <!-- / Layout page -->
        </div>

        <!-- Overlay -->
        <div class="layout-overlay layout-menu-toggle"></div>

        <!-- Drag Target Area To SlideIn Menu On Small Screens -->
        <div class="drag-target"></div>
    </div>
    <!-- / Layout wrapper -->


    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/assets/js/token-manager.js"></script>
    <script src="/assets/js/auth-guard.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            fetch('/api/dashboard/stats')
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.stats) {
                        document.getElementById('stat-products').textContent = data.stats.totalProducts;
                        document.getElementById('stat-customers').textContent = data.stats.totalCustomers;
                        document.getElementById('stat-sellers').textContent = data.stats.totalSellers;
                        document.getElementById('stat-merchants').textContent = data.stats.totalMerchants;
                        document.getElementById('stat-orders').textContent = data.stats.totalOrders;
                        document.getElementById('stat-categories').textContent = data.stats.totalCategories;
                        document.getElementById('stat-newsletter').textContent = data.stats.totalNewsletter;
                        document.getElementById('stat-contacts').textContent = data.stats.totalContacts;
                        document.getElementById('stat-job-applications').textContent = data.stats.totalJobApplications;
                        document.getElementById('stat-team').textContent = data.stats.totalTeam;
                        document.getElementById('stat-sliders').textContent = data.stats.totalSliders;

                        // Chart.js Bar Chart
                        const barCanvas = document.getElementById('statsBarChart');
                        if (barCanvas) {
                            const barCtx = barCanvas.getContext('2d');
                            new Chart(barCtx, {
                                type: 'bar',
                                data: {
                                    labels: ['Products', 'Customers', 'Sellers', 'Merchants'],
                                    datasets: [{
                                        label: 'Count',
                                        data: [
                                            data.stats.totalProducts,
                                            data.stats.totalCustomers,
                                            data.stats.totalSellers,
                                            data.stats.totalMerchants
                                        ],
                                        backgroundColor: [
                                            '#696cff', '#03c3ec', '#ffab00', '#71dd37'
                                        ]
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    plugins: { legend: { display: false } }
                                }
                            });
                        }

                        // Chart.js Doughnut Chart
                        const doughnutCanvas = document.getElementById('statsDoughnutChart');
                        if (doughnutCanvas) {
                            const doughnutCtx = doughnutCanvas.getContext('2d');
                            new Chart(doughnutCtx, {
                                type: 'doughnut',
                                data: {
                                    labels: ['Orders', 'Categories', 'Newsletter', 'Contacts'],
                                    datasets: [{
                                        data: [
                                            data.stats.totalOrders,
                                            data.stats.totalCategories,
                                            data.stats.totalNewsletter,
                                            data.stats.totalContacts
                                        ],
                                        backgroundColor: [
                                            '#03c3ec', '#233446', '#ff3e1d', '#ffab00'
                                        ]
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    plugins: { legend: { position: 'bottom' } }
                                }
                            });
                        }
                    }
                })
                .catch(err => {
                    console.error('Dashboard stats fetch error:', err);
                });
        });
    </script>


</body>

</html>