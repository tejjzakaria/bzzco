<!doctype html>

<html lang="en" class="layout-navbar-fixed layout-menu-fixed layout-compact" dir="ltr" data-skin="default"
    data-bs-theme="light" data-assets-path="/assets/" data-template="vertical-menu-template">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Dashboard - Bzz Co.</title>
    <meta name="description" content="" />
    <%- include("layout/header") %>
</head>

<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include("layout/sidebar") %>

            <div class="menu-mobile-toggler d-xl-none rounded-1">
                <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large text-bg-secondary p-2 rounded-1">
                    <i class="ri ri-menu-line icon-base"></i>
                    <i class="ri ri-arrow-right-s-line icon-base"></i>
                </a>
            </div>

            <div class="layout-page">
                <%- include("layout/header") %>

                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">

                        <!-- Welcome Card -->
                        <div class="row g-6 mb-6">
                            <div class="col-12">
                                <div class="card">
                                    <div class="d-flex align-items-end row">
                                        <div class="col-md-6 order-2 order-md-1">
                                            <div class="card-body">
                                                <h4 class="card-title mb-4">Welcome back, <span class="fw-bold">Admin!</span></h4>
                                                <p class="mb-0">Here's what's happening with your store today.</p>
                                                <p class="mb-4">Track your sales, monitor products, and manage your business efficiently.</p>
                                            </div>
                                        </div>
                                        <div class="col-md-6 text-center text-md-end order-1 order-md-2">
                                            <div class="card-body pb-0 px-0 pt-1_5">
                                                <img src="/assets/img/illustrations/illustration-john-light.png"
                                                    height="186" class="scaleX-n1-rtl" alt="Welcome"
                                                    data-app-light-img="illustrations/illustration-john-light.png"
                                                    data-app-dark-img="illustrations/illustration-john-dark.png" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Key Metrics Row -->
                        <div class="row g-6 mb-6">
                            <div class="col-xl-3 col-sm-6">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="text-muted mb-2">Total Revenue</h6>
                                                <h3 class="mb-1" id="totalRevenue">$0.00</h3>
                                                <small class="text-success"><i class="icon-base ri ri-arrow-up-line"></i> From paid orders</small>
                                            </div>
                                            <div class="avatar">
                                                <div class="avatar-initial bg-label-success rounded">
                                                    <i class="icon-base ri ri-money-dollar-circle-line icon-24px"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-3 col-sm-6">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="text-muted mb-2">Total Orders</h6>
                                                <h3 class="mb-1" id="totalOrders">0</h3>
                                                <small class="text-muted"><span id="ordersThisMonth">0</span> this month</small>
                                            </div>
                                            <div class="avatar">
                                                <div class="avatar-initial bg-label-primary rounded">
                                                    <i class="icon-base ri ri-shopping-bag-3-line icon-24px"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-3 col-sm-6">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="text-muted mb-2">Total Customers</h6>
                                                <h3 class="mb-1" id="totalCustomers">0</h3>
                                                <small class="text-muted"><span id="customersThisMonth">0</span> new this month</small>
                                            </div>
                                            <div class="avatar">
                                                <div class="avatar-initial bg-label-info rounded">
                                                    <i class="icon-base ri ri-user-3-line icon-24px"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-3 col-sm-6">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="text-muted mb-2">Total Products</h6>
                                                <h3 class="mb-1" id="totalProducts">0</h3>
                                                <small class="text-warning"><span id="outOfStockProducts">0</span> out of stock</small>
                                            </div>
                                            <div class="avatar">
                                                <div class="avatar-initial bg-label-warning rounded">
                                                    <i class="icon-base ri ri-box-3-line icon-24px"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Charts Row 1 -->
                        <div class="row g-6 mb-6">
                            <div class="col-xl-8">
                                <div class="card h-100">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">Revenue Overview</h5>
                                        <small class="text-muted">Last 6 months</small>
                                    </div>
                                    <div class="card-body">
                                        <canvas id="revenueChart" height="100"></canvas>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-4">
                                <div class="card h-100">
                                    <div class="card-header">
                                        <h5 class="mb-0">Order Status</h5>
                                    </div>
                                    <div class="card-body">
                                        <canvas id="orderStatusChart" height="200"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Recent Activity & Quick Stats -->
                        <div class="row g-6 mb-6">
                            <div class="col-xl-6">
                                <div class="card h-100">
                                    <div class="card-header">
                                        <h5 class="mb-0">Recent Activity</h5>
                                    </div>
                                    <div class="card-body">
                                        <ul class="list-unstyled mb-0">
                                            <li class="mb-4 d-flex align-items-center">
                                                <div class="avatar avatar-sm flex-shrink-0 me-3">
                                                    <span class="avatar-initial rounded-circle bg-label-primary">
                                                        <i class="icon-base ri ri-shopping-cart-line"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-0">Orders Today</h6>
                                                    <small class="text-muted">New orders received</small>
                                                </div>
                                                <div class="text-end">
                                                    <h5 class="mb-0" id="ordersToday">0</h5>
                                                </div>
                                            </li>
                                            <li class="mb-4 d-flex align-items-center">
                                                <div class="avatar avatar-sm flex-shrink-0 me-3">
                                                    <span class="avatar-initial rounded-circle bg-label-warning">
                                                        <i class="icon-base ri ri-time-line"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-0">Pending Orders</h6>
                                                    <small class="text-muted">Awaiting processing</small>
                                                </div>
                                                <div class="text-end">
                                                    <h5 class="mb-0" id="pendingOrders">0</h5>
                                                </div>
                                            </li>
                                            <li class="mb-4 d-flex align-items-center">
                                                <div class="avatar avatar-sm flex-shrink-0 me-3">
                                                    <span class="avatar-initial rounded-circle bg-label-success">
                                                        <i class="icon-base ri ri-check-line"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-0">Completed Orders</h6>
                                                    <small class="text-muted">Successfully delivered</small>
                                                </div>
                                                <div class="text-end">
                                                    <h5 class="mb-0" id="completedOrders">0</h5>
                                                </div>
                                            </li>
                                            <li class="d-flex align-items-center">
                                                <div class="avatar avatar-sm flex-shrink-0 me-3">
                                                    <span class="avatar-initial rounded-circle bg-label-info">
                                                        <i class="icon-base ri ri-calendar-line"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-0">Orders This Week</h6>
                                                    <small class="text-muted">Last 7 days</small>
                                                </div>
                                                <div class="text-end">
                                                    <h5 class="mb-0" id="ordersThisWeek">0</h5>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-6">
                                <div class="card h-100">
                                    <div class="card-header">
                                        <h5 class="mb-0">Top Selling Products</h5>
                                    </div>
                                    <div class="card-body">
                                        <div id="topProductsList">
                                            <p class="text-muted text-center py-4">Loading...</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Stats Grid -->
                        <div class="row g-6">
                            <div class="col-xl-2 col-md-4 col-sm-6">
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        <div class="avatar avatar-md mx-auto mb-3">
                                            <span class="avatar-initial rounded bg-label-success">
                                                <i class="icon-base ri ri-store-2-line icon-24px"></i>
                                            </span>
                                        </div>
                                        <h5 class="mb-0" id="totalMerchants">0</h5>
                                        <small class="text-muted">Merchants</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-2 col-md-4 col-sm-6">
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        <div class="avatar avatar-md mx-auto mb-3">
                                            <span class="avatar-initial rounded bg-label-warning">
                                                <i class="icon-base ri ri-user-star-line icon-24px"></i>
                                            </span>
                                        </div>
                                        <h5 class="mb-0" id="totalSellers">0</h5>
                                        <small class="text-muted">Sellers</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-2 col-md-4 col-sm-6">
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        <div class="avatar avatar-md mx-auto mb-3">
                                            <span class="avatar-initial rounded bg-label-primary">
                                                <i class="icon-base ri ri-folders-line icon-24px"></i>
                                            </span>
                                        </div>
                                        <h5 class="mb-0" id="totalCategories">0</h5>
                                        <small class="text-muted">Categories</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-2 col-md-4 col-sm-6">
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        <div class="avatar avatar-md mx-auto mb-3">
                                            <span class="avatar-initial rounded bg-label-info">
                                                <i class="icon-base ri ri-pages-line icon-24px"></i>
                                            </span>
                                        </div>
                                        <h5 class="mb-0" id="totalPages">0</h5>
                                        <small class="text-muted">Pages</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-2 col-md-4 col-sm-6">
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        <div class="avatar avatar-md mx-auto mb-3">
                                            <span class="avatar-initial rounded bg-label-danger">
                                                <i class="icon-base ri ri-mail-line icon-24px"></i>
                                            </span>
                                        </div>
                                        <h5 class="mb-0" id="totalContacts">0</h5>
                                        <small class="text-muted">Messages</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-2 col-md-4 col-sm-6">
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        <div class="avatar avatar-md mx-auto mb-3">
                                            <span class="avatar-initial rounded bg-label-secondary">
                                                <i class="icon-base ri ri-team-line icon-24px"></i>
                                            </span>
                                        </div>
                                        <h5 class="mb-0" id="totalTeam">0</h5>
                                        <small class="text-muted">Team</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <%- include("layout/footer") %>
                    <div class="content-backdrop fade"></div>
                </div>
            </div>
        </div>

        <div class="layout-overlay layout-menu-toggle"></div>
        <div class="drag-target"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/assets/js/token-manager.js"></script>
    <script src="/assets/js/auth-guard.js"></script>
    <script src="/assets/js/user-profile-loader.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            fetch('/api/dashboard/stats')
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.stats) {
                        const stats = data.stats;

                        // Update key metrics
                        document.getElementById('totalRevenue').textContent = '$' + parseFloat(stats.totalRevenue).toLocaleString();
                        document.getElementById('totalOrders').textContent = stats.totalOrders;
                        document.getElementById('ordersThisMonth').textContent = stats.ordersThisMonth;
                        document.getElementById('totalCustomers').textContent = stats.totalCustomers;
                        document.getElementById('customersThisMonth').textContent = stats.customersThisMonth;
                        document.getElementById('totalProducts').textContent = stats.totalProducts;
                        document.getElementById('outOfStockProducts').textContent = stats.outOfStockProducts;

                        // Update activity stats
                        document.getElementById('ordersToday').textContent = stats.ordersToday;
                        document.getElementById('ordersThisWeek').textContent = stats.ordersThisWeek;
                        document.getElementById('pendingOrders').textContent = stats.pendingOrders;
                        document.getElementById('completedOrders').textContent = stats.completedOrders;

                        // Update quick stats
                        document.getElementById('totalMerchants').textContent = stats.totalMerchants;
                        document.getElementById('totalSellers').textContent = stats.totalSellers;
                        document.getElementById('totalCategories').textContent = stats.totalCategories;
                        document.getElementById('totalPages').textContent = stats.totalPages;
                        document.getElementById('totalContacts').textContent = stats.totalContacts;
                        document.getElementById('totalTeam').textContent = stats.totalTeam;

                        // Revenue Chart
                        const revenueCanvas = document.getElementById('revenueChart');
                        if (revenueCanvas && stats.monthlyRevenue) {
                            const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                            const revenueLabels = stats.monthlyRevenue.map(item =>
                                monthNames[item._id.month - 1] + ' ' + item._id.year
                            );
                            const revenueData = stats.monthlyRevenue.map(item => item.revenue);

                            new Chart(revenueCanvas.getContext('2d'), {
                                type: 'line',
                                data: {
                                    labels: revenueLabels,
                                    datasets: [{
                                        label: 'Revenue',
                                        data: revenueData,
                                        borderColor: '#f97316',
                                        backgroundColor: 'rgba(249, 115, 22, 0.1)',
                                        tension: 0.4,
                                        fill: true,
                                        pointBackgroundColor: '#f97316',
                                        pointBorderColor: '#fff',
                                        pointHoverBackgroundColor: '#fff',
                                        pointHoverBorderColor: '#f97316'
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: true,
                                    plugins: {
                                        legend: { display: false },
                                        tooltip: {
                                            callbacks: {
                                                label: function(context) {
                                                    return 'Revenue: $' + context.parsed.y.toLocaleString();
                                                }
                                            }
                                        }
                                    },
                                    scales: {
                                        y: {
                                            beginAtZero: true,
                                            ticks: {
                                                callback: function(value) {
                                                    return '$' + value.toLocaleString();
                                                }
                                            }
                                        }
                                    }
                                }
                            });
                        }

                        // Order Status Chart
                        const orderStatusCanvas = document.getElementById('orderStatusChart');
                        if (orderStatusCanvas && stats.ordersByStatus) {
                            const statusLabels = stats.ordersByStatus.map(item => item._id || 'Unknown');
                            const statusData = stats.ordersByStatus.map(item => item.count);
                            const statusColors = ['#f97316', '#71dd37', '#ffab00', '#03c3ec', '#8592a3'];

                            new Chart(orderStatusCanvas.getContext('2d'), {
                                type: 'doughnut',
                                data: {
                                    labels: statusLabels,
                                    datasets: [{
                                        data: statusData,
                                        backgroundColor: statusColors.slice(0, statusData.length),
                                        borderWidth: 2,
                                        borderColor: '#fff'
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: true,
                                    plugins: {
                                        legend: { position: 'bottom' }
                                    }
                                }
                            });
                        }

                        // Top Products List
                        const topProductsList = document.getElementById('topProductsList');
                        if (topProductsList && stats.topProducts && stats.topProducts.length > 0) {
                            topProductsList.innerHTML = stats.topProducts.map((item, index) => `
                                <div class="d-flex align-items-center mb-3 ${index !== stats.topProducts.length - 1 ? 'pb-3 border-bottom' : ''}">
                                    <div class="badge bg-label-primary rounded-pill me-3">${index + 1}</div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0">${item.product ? item.product.name : 'Unknown Product'}</h6>
                                        <small class="text-muted">${item.totalQuantity} units sold</small>
                                    </div>
                                    <div class="text-end">
                                        <h6 class="mb-0 text-success">$${item.totalRevenue.toLocaleString()}</h6>
                                    </div>
                                </div>
                            `).join('');
                        } else {
                            topProductsList.innerHTML = '<p class="text-muted text-center py-4">No sales data available yet</p>';
                        }
                    }
                })
                .catch(err => {
                    console.error('Dashboard stats fetch error:', err);
                });
        });
    </script>

</body>

</html>
