<!doctype html>

<html lang="en" class="layout-navbar-fixed layout-menu-fixed layout-compact" dir="ltr" data-skin="default"
    data-bs-theme="light" data-assets-path="/assets/" data-template="vertical-menu-template">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Categories - Bzz Co.</title>

    <meta name="description" content="" />
    <%- include("layout/header") %>
</head>

<body>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu -->

            <%- include("layout/sidebar") %>

                <div class="menu-mobile-toggler d-xl-none rounded-1">
                    <a href="javascript:void(0);"
                        class="layout-menu-toggle menu-link text-large text-bg-secondary p-2 rounded-1">
                        <i class="ri ri-menu-line icon-base"></i>
                        <i class="ri ri-arrow-right-s-line icon-base"></i>
                    </a>
                </div>
                <!-- / Menu -->

                <!-- Layout container -->
                <div class="layout-page">
                    <!-- Navbar -->

                    <%- include("layout/header") %>

                        <!-- / Navbar -->

                        <!-- Content wrapper -->
                        <div class="content-wrapper">
                            <!-- Content -->

                            <div class="container-xxl flex-grow-1 container-p-y">
                                <div class="row g-6 mb-6">
                                    <div class="col-sm-6 col-xl-4">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between">
                                                    <div class="me-1">
                                                        <p class="text-heading mb-1">Total Categories</p>
                                                        <div class="d-flex align-items-center">
                                                            <h4 class="mb-1 me-2"><%= stats.total %></h4>
                                                            <p class="text-success mb-1">(100%)</p>
                                                        </div>
                                                        <small class="mb-0">Total Categories</small>
                                                    </div>
                                                    <div class="avatar">
                                                        <div class="avatar-initial bg-label-primary rounded-3">
                                                            <div class="icon-base ri ri-folder-line icon-26px"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 col-xl-4">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between">
                                                    <div class="me-1">
                                                        <p class="text-heading mb-1">Active Categories</p>
                                                        <div class="d-flex align-items-center">
                                                            <h4 class="mb-1 me-1"><%= stats.active %></h4>
                                                            <p class="text-success mb-1">(<%= stats.activePercentage %>%)</p>
                                                        </div>
                                                        <small class="mb-0">Active categories</small>
                                                    </div>
                                                    <div class="avatar">
                                                        <div class="avatar-initial bg-label-success rounded-3">
                                                            <div class="icon-base ri ri-check-line icon-26px"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 col-xl-4">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between">
                                                    <div class="me-1">
                                                        <p class="text-heading mb-1">Inactive Categories</p>
                                                        <div class="d-flex align-items-center">
                                                            <h4 class="mb-1 me-1"><%= stats.inactive %></h4>
                                                            <p class="text-danger mb-1">(<%= stats.inactivePercentage %>%)</p>
                                                        </div>
                                                        <small class="mb-0">Inactive categories</small>
                                                    </div>
                                                    <div class="avatar">
                                                        <div class="avatar-initial bg-label-warning rounded-3">
                                                            <div class="icon-base ri ri-close-line icon-26px"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                </div>
                                <!-- Categories List Table -->
                                <div class="card">
                                    <div class="card-header border-bottom">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="card-title mb-0">Categories List</h5>
                                        </div>
                                    </div>
                                    <div class="card-datatable">
                                        <table class="datatables-categories table">
                                            <thead>
                                                <tr>
                                                    <th></th>
                                                    <th><input type="checkbox" class="form-check-input"
                                                            id="select-all-categories"></th>
                                                    <th>Category</th>
                                                    <th>Description</th>
                                                    <th>Status</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                    <!-- Offcanvas to add new category -->
                                    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddCategory"
                                        aria-labelledby="offcanvasAddCategoryLabel">
                                        <div class="offcanvas-header border-bottom">
                                            <h5 id="offcanvasAddCategoryLabel" class="offcanvas-title">Add Category</h5>
                                            <button type="button" class="btn-close text-reset"
                                                data-bs-dismiss="offcanvas" aria-label="Close"></button>
                                        </div>
                                        <div class="offcanvas-body mx-0 flex-grow-0 h-100">
                                            <form action="/api/categories" method="POST" class="add-new-category pt-0"
                                                id="addNewCategoryForm">
                                                <div
                                                    class="form-floating form-floating-outline mb-5 form-control-validation">
                                                    <input type="text" class="form-control" id="add-category-name"
                                                        placeholder="Electronics" name="name"
                                                        aria-label="Electronics" />
                                                    <label for="add-category-name">Category Name</label>
                                                </div>
                                                <div class="form-floating form-floating-outline mb-5">
                                                    <textarea class="form-control" id="add-category-description"
                                                        placeholder="Category description" name="description"
                                                        rows="3"></textarea>
                                                    <label for="add-category-description">Description</label>
                                                </div>
                                                <div class="form-floating form-floating-outline mb-5">
                                                    <select id="add-category-status" class="form-select" name="status">
                                                        <option value="active">Active</option>
                                                        <option value="inactive">Inactive</option>
                                                    </select>
                                                    <label for="add-category-status">Status</label>
                                                </div>

                                                <button type="submit"
                                                    class="btn btn-primary me-sm-3 me-1 data-submit">Add</button>
                                                <button type="reset" class="btn btn-outline-danger"
                                                    data-bs-dismiss="offcanvas">Cancel</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- / Content -->

                            <!-- Footer -->
                            <%- include("layout/footer") %>
                                <!-- / Footer -->

                                <div class="content-backdrop fade"></div>
                        </div>
                        <!-- Content wrapper -->
                </div>
                <!-- / Layout page -->
        </div>

        <!-- Overlay -->
        <div class="layout-overlay layout-menu-toggle"></div>

        <!-- Drag Target Area To SlideIn Menu On Small Screens -->
        <div class="drag-target"></div>
    </div>
    <!-- / Layout wrapper -->
    

            <!-- DataTables Initialization -->
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    let borderColor, bodyBg, headingColor;

                    // Get config colors if available
                    if (typeof config !== 'undefined') {
                        borderColor = config.colors.borderColor;
                        bodyBg = config.colors.bodyBg;
                        headingColor = config.colors.headingColor;
                    }

                    // Variable declaration for table
                    const dt_category_table = document.querySelector('.datatables-categories'),
                        statusObj = {
                            1: { title: 'Active', class: 'bg-label-success' },
                            2: { title: 'Inactive', class: 'bg-label-secondary' }
                        };

                    // Declare dt_category variable at higher scope
                    let dt_category;

                    // Categories datatable
                    if (dt_category_table) {
                        dt_category = new DataTable(dt_category_table, {
                            ajax: {
                                url: '/api/categories/datatable',
                                type: 'GET',
                                dataSrc: function(json) {
                                    return json.data || json;
                                },
                                error: function(xhr, error, thrown) {
                                    console.error('DataTable Ajax Error:', error);
                                    return [];
                                }
                            },
                            columns: [
                                // columns according to JSON
                                { data: '_id' },
                                { data: '_id', orderable: false },
                                { data: 'name' },
                                { data: 'description' },
                                { data: 'status' },
                                { data: null, orderable: false, searchable: false } // Actions column
                            ],
                            columnDefs: [
                                {
                                    // For Responsive
                                    className: 'control',
                                    searchable: false,
                                    orderable: false,
                                    responsivePriority: 2,
                                    targets: 0,
                                    render: function (data, type, full, meta) {
                                        return '';
                                    }
                                },
                                {
                                    // For Checkboxes
                                    targets: 1,
                                    orderable: false,
                                    searchable: false,
                                    responsivePriority: 4,
                                    render: function () {
                                        return '<input type="checkbox" class="dt-checkboxes form-check-input">';
                                    }
                                },
                                {
                                    targets: 2,
                                    responsivePriority: 4,
                                    render: function (data, type, full, meta) {
                                        var name = full['name'];
                                        var description = full['description'];

                                        // Creates full output for row
                                        var row_output =
                                            '<div class="d-flex justify-content-start align-items-center category-name">' +
                                            '<div class="d-flex flex-column">' +
                                            '<span class="text-heading text-truncate fw-medium">' +
                                            name +
                                            '</span>' +
                                            '<small class="text-muted">' +
                                            description.substring(0, 30) + (description.length > 30 ? '...' : '') +
                                            '</small>' +
                                            '</div>' +
                                            '</div>';
                                        return row_output;
                                    }
                                },
                                {
                                    // Description
                                    targets: 3,
                                    render: function (data, type, full, meta) {
                                        let description = full['description'];
                                        return '<span class="text-heading">' + description + '</span>';
                                    }
                                },
                                {
                                    // Status
                                    targets: 4,
                                    render: function (data, type, full, meta) {
                                        const status = full['status'];
                                        const badgeClass = status === 'active' ? 'bg-label-success' : 'bg-label-secondary';
                                        const statusText = status.charAt(0).toUpperCase() + status.slice(1);
                                        return '<span class="badge ' + badgeClass + '">' + statusText + '</span>';
                                    }
                                },
                                {
                                    targets: -1,
                                    title: 'Actions',
                                    searchable: false,
                                    orderable: false,
                                    render: (data, type, full, meta) => {
                                        const categoryId = full['_id'];
                                        return `
                                  <div class="d-flex align-items-center gap-1">
                                    <button type="button" class="btn btn-icon btn-text-secondary rounded-pill edit-record" data-category-id="${categoryId}" title="Edit Category">
                                      <i class="icon-base ri ri-edit-line icon-md text-primary"></i>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-text-secondary rounded-pill delete-record" data-category-id="${categoryId}" title="Delete Category">
                                      <i class="icon-base ri ri-delete-bin-7-line icon-md text-danger"></i>
                                    </button>
                                  </div>
                                `;
                                    }
                                }
                            ],
                            order: [[2, 'asc']],
                            layout: {
                                topStart: {
                                    rowClass: 'row m-2 my-0 mt-0 justify-content-between',
                                    features: [
                                        {
                                            buttons: [
                                                {
                                                    text: '<i class="icon-base ri ri-delete-bin-line icon-sm me-0 me-sm-1"></i><span class="d-none d-sm-inline-block">Delete Selected</span>',
                                                    className: 'btn btn-outline-danger bulk-delete-btn',
                                                    attr: {
                                                        'style': 'display: none;'
                                                    },
                                                    action: function (e, dt, node, config) {
                                                        bulkDeleteCategories();
                                                    }
                                                },
                                                {
                                                    extend: 'collection',
                                                    className: 'btn btn-outline-secondary dropdown-toggle waves-effect',
                                                    text: '<span class="d-flex align-items-center gap-2"><i class="icon-base ri ri-upload-2-line icon-16px me-sm-1"></i> <span class="d-none d-sm-inline-block">Export</span></span>',
                                                    buttons: [
                                                        {
                                                            extend: 'print',
                                                            text: `<span class="d-flex align-items-center"><i class="icon-base ri ri-printer-line me-1"></i>Print</span>`,
                                                            className: 'dropdown-item',
                                                            exportOptions: {
                                                                columns: [2, 3, 4],
                                                                format: {
                                                                    body: function (inner, coldex, rowdex) {
                                                                        if (inner.length <= 0) return inner;
                                                                        const el = new DOMParser().parseFromString(inner, 'text/html').body.childNodes;
                                                                        let result = '';
                                                                        el.forEach(item => {
                                                                            if (item.classList && item.classList.contains('category-name')) {
                                                                                result += item.lastChild.firstChild.textContent;
                                                                            } else {
                                                                                result += item.textContent || item.innerText || '';
                                                                            }
                                                                        });
                                                                        return result;
                                                                    }
                                                                }
                                                            },
                                                            customize: function (win) {
                                                                if (typeof config !== 'undefined') {
                                                                    win.document.body.style.color = config.colors.headingColor;
                                                                    win.document.body.style.borderColor = config.colors.borderColor;
                                                                    win.document.body.style.backgroundColor = config.colors.bodyBg;
                                                                }
                                                                const table = win.document.body.querySelector('table');
                                                                table.classList.add('compact');
                                                                table.style.color = 'inherit';
                                                                table.style.borderColor = 'inherit';
                                                                table.style.backgroundColor = 'inherit';
                                                            }
                                                        },
                                                        {
                                                            extend: 'csv',
                                                            text: `<span class="d-flex align-items-center"><i class="icon-base ri ri-file-text-line me-1"></i>Csv</span>`,
                                                            className: 'dropdown-item',
                                                            exportOptions: {
                                                                columns: [2, 3, 4],
                                                                format: {
                                                                    body: function (inner, coldex, rowdex) {
                                                                        if (inner.length <= 0) return inner;
                                                                        const el = new DOMParser().parseFromString(inner, 'text/html').body.childNodes;
                                                                        let result = '';
                                                                        el.forEach(item => {
                                                                            if (item.classList && item.classList.contains('category-name')) {
                                                                                result += item.lastChild.firstChild.textContent;
                                                                            } else {
                                                                                result += item.textContent || item.innerText || '';
                                                                            }
                                                                        });
                                                                        return result;
                                                                    }
                                                                }
                                                            }
                                                        },
                                                        {
                                                            extend: 'excel',
                                                            text: `<span class="d-flex align-items-center"><i class="icon-base ri ri-file-excel-line me-1"></i>Excel</span>`,
                                                            className: 'dropdown-item',
                                                            exportOptions: {
                                                                columns: [2, 3, 4],
                                                                format: {
                                                                    body: function (inner, coldex, rowdex) {
                                                                        if (inner.length <= 0) return inner;
                                                                        const el = new DOMParser().parseFromString(inner, 'text/html').body.childNodes;
                                                                        let result = '';
                                                                        el.forEach(item => {
                                                                            if (item.classList && item.classList.contains('category-name')) {
                                                                                result += item.lastChild.firstChild.textContent;
                                                                            } else {
                                                                                result += item.textContent || item.innerText || '';
                                                                            }
                                                                        });
                                                                        return result;
                                                                    }
                                                                }
                                                            }
                                                        },
                                                        {
                                                            extend: 'pdf',
                                                            text: `<span class="d-flex align-items-center"><i class="icon-base ri ri-file-pdf-line me-1"></i>Pdf</span>`,
                                                            className: 'dropdown-item',
                                                            exportOptions: {
                                                                columns: [2, 3, 4],
                                                                format: {
                                                                    body: function (inner, coldex, rowdex) {
                                                                        if (inner.length <= 0) return inner;
                                                                        const el = new DOMParser().parseFromString(inner, 'text/html').body.childNodes;
                                                                        let result = '';
                                                                        el.forEach(item => {
                                                                            if (item.classList && item.classList.contains('category-name')) {
                                                                                result += item.lastChild.firstChild.textContent;
                                                                            } else {
                                                                                result += item.textContent || item.innerText || '';
                                                                            }
                                                                        });
                                                                        return result;
                                                                    }
                                                                }
                                                            }
                                                        },
                                                        {
                                                            extend: 'copy',
                                                            text: `<i class="icon-base ri ri-file-copy-line me-1"></i>Copy`,
                                                            className: 'dropdown-item',
                                                            exportOptions: {
                                                                columns: [2, 3, 4],
                                                                format: {
                                                                    body: function (inner, coldex, rowdex) {
                                                                        if (inner.length <= 0) return inner;
                                                                        const el = new DOMParser().parseFromString(inner, 'text/html').body.childNodes;
                                                                        let result = '';
                                                                        el.forEach(item => {
                                                                            if (item.classList && item.classList.contains('category-name')) {
                                                                                result += item.lastChild.firstChild.textContent;
                                                                            } else {
                                                                                result += item.textContent || item.innerText || '';
                                                                            }
                                                                        });
                                                                        return result;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                topEnd: {
                                    features: [
                                        {
                                            search: {
                                                placeholder: 'Search Category',
                                                text: '_INPUT_'
                                            }
                                        },
                                        {
                                            buttons: [
                                                {
                                                    text: '<i class="icon-base ri ri-add-line icon-sm me-0 me-sm-2 d-sm-none d-inline-block"></i><span class="d-none d-sm-inline-block">Add New Category</span>',
                                                    className: 'add-new btn btn-primary',
                                                    attr: {
                                                        'data-bs-toggle': 'offcanvas',
                                                        'data-bs-target': '#offcanvasAddCategory'
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                },
                                bottomStart: {
                                    rowClass: 'row mx-3 justify-content-between',
                                    features: ['info']
                                },
                                bottomEnd: 'paging'
                            },
                            language: {
                                paginate: {
                                    next: '<i class="icon-base ri ri-arrow-right-s-line scaleX-n1-rtl icon-22px"></i>',
                                    previous: '<i class="icon-base ri ri-arrow-left-s-line scaleX-n1-rtl icon-22px"></i>',
                                    first: '<i class="icon-base ri ri-skip-back-mini-line scaleX-n1-rtl icon-22px"></i>',
                                    last: '<i class="icon-base ri ri-skip-forward-mini-line scaleX-n1-rtl icon-22px"></i>'
                                }
                            },
                            // For responsive popup
                            responsive: {
                                details: {
                                    display: DataTable.Responsive.display.modal({
                                        header: function (row) {
                                            const data = row.data();
                                            return 'Details of ' + data['name'];
                                        }
                                    }),
                                    type: 'column',
                                    renderer: function (api, rowIdx, columns) {
                                        const data = columns
                                            .map(function (col) {
                                                return col.title !== '' // Do not show row in modal popup if title is blank (for check box)
                                                    ? `<tr data-dt-row="${col.rowIndex}" data-dt-column="${col.columnIndex}">
                          <td>${col.title}:</td>
                          <td>${col.data}</td>
                        </tr>`
                                                    : '';
                                            })
                                            .join('');

                                        if (data) {
                                            const div = document.createElement('div');
                                            div.classList.add('table-responsive');
                                            const table = document.createElement('table');
                                            div.appendChild(table);
                                            table.classList.add('table');
                                            const tbody = document.createElement('tbody');
                                            tbody.innerHTML = data;
                                            table.appendChild(tbody);
                                            return div;
                                        }
                                        return false;
                                    }
                                }
                            },
                            initComplete: function () {
                                const api = this.api();

                                // Helper function to create a select dropdown and append options
                                const createFilter = (columnIndex, containerClass, selectId, defaultOptionText) => {
                                    const column = api.column(columnIndex);
                                    const select = document.createElement('select');
                                    select.id = selectId;
                                    select.className = 'form-select text-capitalize';
                                    select.innerHTML = `<option value="">${defaultOptionText}</option>`;
                                    document.querySelector(containerClass).appendChild(select);

                                    // Add event listener for filtering
                                    select.addEventListener('change', () => {
                                        const val = select.value ? `^${select.value}$` : '';
                                        column.search(val, true, false).draw();
                                    });

                                    // Populate options based on unique column data
                                    const uniqueData = Array.from(new Set(column.data().toArray())).sort();
                                    uniqueData.forEach(d => {
                                        const option = document.createElement('option');
                                        option.value = d;
                                        option.textContent = d;
                                        select.appendChild(option);
                                    });
                                };

                                // Status filter
                                createFilter(4, '.category_status', 'CategoryStatus', 'Select Status');

                                // Type filter (can be used for category type if needed)
                                const typeFilter = document.createElement('select');
                                typeFilter.id = 'CategoryType';
                                typeFilter.className = 'form-select text-capitalize';
                                typeFilter.innerHTML = '<option value="">Select Type</option>';
                                document.querySelector('.category_type').appendChild(typeFilter);

                                // Additional filter
                                const additionalFilter = document.createElement('select');
                                additionalFilter.id = 'CategoryFilter';
                                additionalFilter.className = 'form-select text-capitalize';
                                additionalFilter.innerHTML = '<option value="">Select Filter</option>';
                                document.querySelector('.category_filter').appendChild(additionalFilter);
                            }
                        });

                        // Initialize bulk delete button after table draws
                        dt_category.on('draw', function () {
                            toggleBulkDeleteButton();
                        });

                        // Handle individual checkbox changes
                        $(dt_category_table).on('change', '.dt-checkboxes', function () {
                            setTimeout(toggleBulkDeleteButton, 10);
                        });

                        // Handle select all checkbox in header
                        $(dt_category_table).on('change', '#select-all-categories', function () {
                            const isChecked = this.checked;
                            $(dt_category_table).find('tbody .dt-checkboxes').prop('checked', isChecked);
                            setTimeout(toggleBulkDeleteButton, 10);
                        });

                        // Update select all checkbox when individual checkboxes change
                        $(dt_category_table).on('change', 'tbody .dt-checkboxes', function () {
                            const totalCheckboxes = $(dt_category_table).find('tbody .dt-checkboxes').length;
                            const checkedCheckboxes = $(dt_category_table).find('tbody .dt-checkboxes:checked').length;
                            const selectAllCheckbox = $(dt_category_table).find('#select-all-categories');

                            if (checkedCheckboxes === 0) {
                                selectAllCheckbox.prop('indeterminate', false);
                                selectAllCheckbox.prop('checked', false);
                            } else if (checkedCheckboxes === totalCheckboxes) {
                                selectAllCheckbox.prop('indeterminate', false);
                                selectAllCheckbox.prop('checked', true);
                            } else {
                                selectAllCheckbox.prop('indeterminate', true);
                                selectAllCheckbox.prop('checked', false);
                            }

                            setTimeout(toggleBulkDeleteButton, 10);
                        });

                        //? Enhanced delete functionality with confirmation
                        function deleteRecord(categoryId, event) {
                            Swal.fire({
                                title: 'Are you sure?',
                                text: "You won't be able to revert this!",
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#d33',
                                cancelButtonColor: '#3085d6',
                                confirmButtonText: 'Yes, delete it!',
                                cancelButtonText: 'Cancel'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    fetch(`/api/categories/${categoryId}`, {
                                        method: 'DELETE'
                                    })
                                    .then(response => response.json())
                                    .then(data => {
                                        if (data.success) {
                                            Swal.fire({
                                                title: 'Deleted!',
                                                text: 'Category has been deleted successfully.',
                                                icon: 'success',
                                                confirmButtonColor: '#3085d6'
                                            });
                                            
                                            // Reload the DataTable
                                            dt_category.ajax.reload(null, false);
                                        } else {
                                            throw new Error(data.message || 'Failed to delete category');
                                        }
                                    })
                                    .catch(error => {
                                        console.error('Error:', error);
                                        Swal.fire({
                                            title: 'Error!',
                                            text: error.message || 'An error occurred while deleting the category.',
                                            icon: 'error',
                                            confirmButtonColor: '#3085d6'
                                        });
                                    });
                                }
                            });
                        }

                        //? Edit functionality to populate form with category data
                        function editRecord(categoryId) {
                            // Fetch category data from the API
                            fetch(`/api/categories/${categoryId}`)
                            .then(response => response.json())
                            .then(data => {
                                if (data.success && data.category) {
                                    const categoryData = data.category;
                                    
                                    // Populate form fields
                                    document.getElementById('add-category-name').value = categoryData.name || '';
                                    document.getElementById('add-category-description').value = categoryData.description || '';
                                    document.getElementById('add-category-status').value = categoryData.status || '';
                                    
                                    // Change form mode to edit
                                    const form = document.getElementById('addNewCategoryForm');
                                    form.dataset.mode = 'edit';
                                    form.dataset.categoryId = categoryId;
                                    
                                    // Update form title and button
                                    const offcanvasTitle = document.querySelector('#offcanvasAddCategory .offcanvas-title');
                                    if (offcanvasTitle) {
                                        offcanvasTitle.textContent = 'Edit Category';
                                    }
                                    const submitButton = document.querySelector('.data-submit');
                                    if (submitButton) {
                                        submitButton.textContent = 'Update';
                                    }
                                    
                                    // Show the offcanvas
                                    const offcanvas = new bootstrap.Offcanvas(document.getElementById('offcanvasAddCategory'));
                                    offcanvas.show();
                                } else {
                                    throw new Error(data.message || 'Failed to fetch category data');
                                }
                            })
                            .catch(error => {
                                console.error('Error:', error);
                                Swal.fire({
                                    title: 'Error!',
                                    text: error.message || 'Failed to fetch category data.',
                                    icon: 'error',
                                    confirmButtonColor: '#3085d6'
                                });
                            });
                        }

                        //? Bulk delete functionality for multiple categories
                        function bulkDeleteCategories() {
                            // Get selected checkboxes and their corresponding data
                            const selectedCheckboxes = document.querySelectorAll('.datatables-categories tbody .dt-checkboxes:checked');

                            if (selectedCheckboxes.length === 0) {
                                Swal.fire({
                                    title: 'No Selection',
                                    text: 'Please select categories to delete.',
                                    icon: 'warning',
                                    confirmButtonColor: '#3085d6'
                                });
                                return;
                            }

                            // Extract category data from selected rows
                            const selectedData = [];
                            selectedCheckboxes.forEach(checkbox => {
                                const row = checkbox.closest('tr');
                                const rowData = dt_category.row(row).data();
                                if (rowData) {
                                    selectedData.push(rowData);
                                }
                            });

                            const categoryIds = selectedData.map(row => row._id);
                            const categoryNames = selectedData.map(row => row.name).join(', ');

                            Swal.fire({
                                title: 'Are you sure?',
                                html: `You are about to delete <strong>${selectedData.length}</strong> category(s):<br><br><em>${categoryNames}</em><br><br>This action cannot be undone!`,
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#d33',
                                cancelButtonColor: '#3085d6',
                                confirmButtonText: `Yes, delete ${selectedData.length} category(s)!`,
                                cancelButtonText: 'Cancel'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    fetch('/api/categories/bulk/delete', {
                                        method: 'DELETE',
                                        headers: {
                                            'Content-Type': 'application/json',
                                        },
                                        body: JSON.stringify({ categoryIds: categoryIds })
                                    })
                                    .then(response => response.json())
                                    .then(data => {
                                        if (data.success) {
                                            Swal.fire({
                                                title: 'Deleted!',
                                                text: `${selectedData.length} categories have been deleted successfully.`,
                                                icon: 'success',
                                                confirmButtonColor: '#3085d6'
                                            });

                                            // Reload the DataTable
                                            dt_category.ajax.reload(null, false);

                                            // Clear all checkboxes and hide delete button
                                            $(dt_category_table).find('.dt-checkboxes').prop('checked', false);
                                            $('#select-all-categories').prop('checked', false).prop('indeterminate', false);
                                            toggleBulkDeleteButton();
                                        } else {
                                            throw new Error(data.message || 'Failed to delete categories');
                                        }
                                    })
                                    .catch(error => {
                                        console.error('Error:', error);
                                        Swal.fire({
                                            title: 'Error!',
                                            text: error.message || 'An error occurred while deleting categories.',
                                            icon: 'error',
                                            confirmButtonColor: '#3085d6'
                                        });
                                    });
                                }
                            });
                        }

                        //? Toggle bulk delete button visibility based on selection
                        function toggleBulkDeleteButton() {
                            const selectedCheckboxes = document.querySelectorAll('.datatables-categories tbody .dt-checkboxes:checked').length;
                            const deleteButton = document.querySelector('.bulk-delete-btn');

                            if (deleteButton) {
                                if (selectedCheckboxes > 0) {
                                    deleteButton.style.display = 'inline-block';
                                    deleteButton.style.visibility = 'visible';
                                    const spanElement = deleteButton.querySelector('span');
                                    if (spanElement) {
                                        spanElement.textContent = `Delete Selected (${selectedCheckboxes})`;
                                    }
                                } else {
                                    deleteButton.style.display = 'none';
                                }
                            }
                        }

                        function bindActionEvents() {
                            const categoryListTable = document.querySelector('.datatables-categories');
                            const modal = document.querySelector('.dtr-bs-modal');

                            if (categoryListTable && categoryListTable.classList.contains('collapsed')) {
                                if (modal) {
                                    modal.addEventListener('click', function (event) {
                                        const target = event.target.closest('.delete-record, .edit-record');
                                        if (target) {
                                            const categoryId = target.dataset.categoryId;
                                            if (target.classList.contains('delete-record')) {
                                                deleteRecord(categoryId, event);
                                                const closeButton = modal.querySelector('.btn-close');
                                                if (closeButton) closeButton.click();
                                            } else if (target.classList.contains('edit-record')) {
                                                editRecord(categoryId);
                                                const closeButton = modal.querySelector('.btn-close');
                                                if (closeButton) closeButton.click();
                                            }
                                        }
                                    });
                                }
                            } else {
                                const tableBody = categoryListTable?.querySelector('tbody');
                                if (tableBody) {
                                    tableBody.addEventListener('click', function (event) {
                                        const target = event.target.closest('.delete-record, .edit-record');
                                        if (target) {
                                            const categoryId = target.dataset.categoryId;
                                            if (target.classList.contains('delete-record')) {
                                                deleteRecord(categoryId, event);
                                            } else if (target.classList.contains('edit-record')) {
                                                editRecord(categoryId);
                                            }
                                        }
                                    });
                                }
                            }
                        }

                        // Initial event binding
                        bindActionEvents();

                        // Re-bind events when modal is shown or hidden
                        document.addEventListener('show.bs.modal', function (event) {
                            if (event.target.classList.contains('dtr-bs-modal')) {
                                bindActionEvents();
                            }
                        });

                        document.addEventListener('hide.bs.modal', function (event) {
                            if (event.target.classList.contains('dtr-bs-modal')) {
                                bindActionEvents();
                            }
                        });
                    }

                    // Filter form control to default size
                    // ? setTimeout used for category-list table initialization
                    setTimeout(() => {
                        const elementsToModify = [
                            { selector: '.dt-buttons .btn', classToRemove: 'btn-secondary' },
                            { selector: '.dt-length .form-select', classToAdd: 'ms-0' },
                            { selector: '.dt-length', classToAdd: 'mb-md-4 mb-0' },
                            {
                                selector: '.dt-layout-end',
                                classToRemove: 'justify-content-between',
                                classToAdd: 'd-flex gap-md-4 justify-content-md-between justify-content-center gap-md-2 flex-wrap mt-0'
                            },
                            { selector: '.dt-layout-start', classToAdd: 'mt-md-0 mt-5' },
                            {
                                selector: '.dt-layout-start .dt-buttons',
                                classToAdd: 'd-md-flex d-block gap-4 justify-content-center'
                            },
                            {
                                selector: '.dt-layout-end .dt-buttons',
                                classToAdd: 'd-md-flex d-block gap-4 mb-md-0 mb-5 justify-content-center'
                            },
                            { selector: '.dt-layout-table', classToRemove: 'row mt-2' },
                            { selector: '.dt-layout-full', classToRemove: 'col-md col-12' },
                            { selector: '.dt-layout-full .table', classToAdd: 'table-responsive' }
                        ];

                        // Apply modifications
                        elementsToModify.forEach(({ selector, classToRemove, classToAdd }) => {
                            document.querySelectorAll(selector).forEach(element => {
                                if (classToRemove) {
                                    classToRemove.split(' ').forEach(className => element.classList.remove(className));
                                }
                                if (classToAdd) {
                                    classToAdd.split(' ').forEach(className => element.classList.add(className));
                                }
                            });
                        });
                    }, 100);

                    // Form handling
                    const addNewCategoryForm = document.getElementById('addNewCategoryForm');

                    // Handle form submission for both add and edit modes
                    if (addNewCategoryForm) {
                        addNewCategoryForm.addEventListener('submit', async function (e) {
                            e.preventDefault();

                            const formData = new FormData(addNewCategoryForm);
                            const categoryData = Object.fromEntries(formData.entries());

                            const isEditMode = addNewCategoryForm.dataset.mode === 'edit';
                            const categoryId = addNewCategoryForm.dataset.categoryId;

                            try {
                                let response;
                                if (isEditMode) {
                                    // Update existing category
                                    response = await fetch(`/api/categories/${categoryId}`, {
                                        method: 'PUT',
                                        headers: {
                                            'Content-Type': 'application/json',
                                        },
                                        body: JSON.stringify(categoryData)
                                    });
                                } else {
                                    // Add new category
                                    response = await fetch('/api/categories', {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/json',
                                        },
                                        body: JSON.stringify(categoryData)
                                    });
                                }

                                if (response.ok) {
                                    const result = await response.json();
                                    
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Success',
                                        text: isEditMode ? 'Category updated successfully!' : 'Category added successfully!',
                                        confirmButtonColor: '#3085d6'
                                    });

                                    // Reload the DataTable to fetch updated data
                                    if (dt_category) {
                                        dt_category.ajax.reload(null, false);
                                    }

                                    // Reset form and close offcanvas
                                    addNewCategoryForm.reset();
                                    addNewCategoryForm.removeAttribute('data-mode');
                                    addNewCategoryForm.removeAttribute('data-category-id');

                                    // Reset form title and button
                                    const offcanvasTitle = document.querySelector('#offcanvasAddCategory .offcanvas-title');
                                    if (offcanvasTitle) {
                                        offcanvasTitle.textContent = 'Add Category';
                                    }
                                    const submitButton = document.querySelector('.data-submit');
                                    if (submitButton) {
                                        submitButton.textContent = 'Add';
                                    }

                                    // Close the offcanvas
                                    const offcanvas = bootstrap.Offcanvas.getInstance(document.getElementById('offcanvasAddCategory'));
                                    if (offcanvas) {
                                        offcanvas.hide();
                                    }
                                } else {
                                    const error = await response.json();
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: error.message || 'Failed to save category',
                                        confirmButtonColor: '#d33'
                                    });
                                }
                            } catch (error) {
                                console.error('Error:', error);
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: 'An error occurred while saving the category',
                                    confirmButtonColor: '#d33'
                                });
                            }
                        });
                    }

                    // Reset form when offcanvas is hidden
                    document.getElementById('offcanvasAddCategory').addEventListener('hidden.bs.offcanvas', function () {
                        if (addNewCategoryForm) {
                            addNewCategoryForm.reset();
                            addNewCategoryForm.removeAttribute('data-mode');
                            addNewCategoryForm.removeAttribute('data-category-id');

                            // Reset form title and button
                            const offcanvasTitle = document.querySelector('#offcanvasAddCategory .offcanvas-title');
                            if (offcanvasTitle) {
                                offcanvasTitle.textContent = 'Add Category';
                            }
                            const submitButton = document.querySelector('.data-submit');
                            if (submitButton) {
                                submitButton.textContent = 'Add';
                            }
                        }
                    });
                });
            </script>
</body>

</html>