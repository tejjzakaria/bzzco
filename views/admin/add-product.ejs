                                        </div>
                                    </div>
                                </form>

                            </div>
                            <!-- / Content -->

                            <!-- Footer -->
                            <%- include("layout/footer") %>
                                <!-- / Footer -->

                                <div class="content-backdrop fade"></div>
                        </div>
                        <!-- Content wrapper -->
                </div>
                <!-- / Layout page -->
        </div>

        <!-- Overlay -->
        <div class="layout-overlay layout-menu-toggle"></div>

        <!-- Drag Target Area To SlideIn Menu On Small Screens -->
        <div class="drag-target"></div>
    </div>
    <!-- / Layout wrapper -->

    <!-- Core JS -->
    <script src="/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="/assets/vendor/libs/popper/popper.js"></script>
    <script src="/assets/vendor/js/bootstrap.js"></script>
    <script src="/assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/assets/vendor/libs/hammer/hammer.js"></script>
    <script src="/assets/vendor/libs/i18n/i18n.js"></script>
    <script src="/assets/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="/assets/vendor/js/menu.js"></script>

    <!-- Vendors JS -->
     <script src="/assets/vendor/libs/tagify/tagify.js"></script>
    <script src="/assets/vendor/libs/select2/select2.js"></script>
    <script src="/assets/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="/assets/vendor/libs/jquery-repeater/jquery-repeater.js"></script>

    
    <script src="/assets/js/forms-tagify.js"></script>
    <!-- <script src="/assets/js/forms-extras.js"></script> -->


    <!-- Main JS -->
    <script src="/assets/js/main.js"></script>

    <!-- Page specific JS -->
    <script>

        // Initialize Select2
        $(document).ready(function () {
            $('#selectedCountries').select2({
                placeholder: 'Select countries',
                allowClear: true
            });
        });

        $(document).ready(function () {
            $('#category').select2();
        });

        // Initialize vendor select2
        $(document).ready(function () {
            $('#vendor').select2({
                placeholder: 'Select Vendor',
                allowClear: true
            });
        });

        // Function to load sellers dynamically (optional)
        async function loadSellersDropdown() {
            try {
                const response = await fetch('/api/sellers-dropdown');
                const data = await response.json();
                
                if (data.sellers) {
                    const vendorSelect = document.getElementById('vendor');
                    // Clear existing options except the first one
                    vendorSelect.innerHTML = '<option value="">Select Vendor</option>';
                    
                    data.sellers.forEach(seller => {
                        const option = document.createElement('option');
                        option.value = seller._id;
                        option.textContent = `${seller.full_name}${seller.company ? ' - ' + seller.company : ''}`;
                        vendorSelect.appendChild(option);
                    });
                    
                    // Refresh Select2 to show new options
                    $('#vendor').trigger('change');
                }
            } catch (error) {
                console.error('Error loading sellers:', error);
            }
        }

        // Uncomment the line below if you want to load sellers dynamically instead of server-side rendering
        // loadSellersDropdown();

        // Initialize Tagify for tags input
        let tagify;
        $(document).ready(function () {
            const tagsInput = document.querySelector('#tags');
            tagify = new Tagify(tagsInput);
        });



        // Image preview functionality
        document.addEventListener('DOMContentLoaded', function () {
            const imageInput = document.getElementById('images');

            // Ensure the input field allows multiple file selection
            imageInput.setAttribute('multiple', 'true');

            // Create a preview container after the file input
            const previewContainer = document.createElement('div');
            previewContainer.id = 'imagePreview';
            previewContainer.className = 'd-flex flex-wrap gap-2 mt-3';
            imageInput.parentNode.appendChild(previewContainer);

            imageInput.addEventListener('change', function (e) {
                const files = e.target.files;
                previewContainer.innerHTML = ''; // Clear previous previews

                if (files.length > 0) {
                    Array.from(files).forEach((file, index) => {
                        if (file.type.startsWith('image/')) {
                            const reader = new FileReader();

                            reader.onload = function (e) {
                                const imageDiv = document.createElement('div');
                                imageDiv.className = 'position-relative d-inline-block';
                                imageDiv.innerHTML = `
                                    <img src="${e.target.result}" 
                                         alt="Preview ${index + 1}" 
                                         class="img-thumbnail" 
                                         style="width: 100px; height: 100px; object-fit: cover;">
                                    <button type="button" 
                                            class="btn btn-sm btn-danger position-absolute top-0 end-0" 
                                            style="transform: translate(50%, -50%); border-radius: 50%; width: 25px; height: 25px; padding: 0;"
                                            onclick="removePreviewImage(this, ${index})">
                                        <i class="ri-close-line" style="font-size: 12px;"></i>
                                    </button>
                                `;
                                previewContainer.appendChild(imageDiv);
                            };

                            reader.readAsDataURL(file);
                        }
                    });
                }
            });
        });

        // Remove preview image
        function removePreviewImage(button, index) {
            const imageDiv = button.parentElement;
            imageDiv.remove();

            // Update the file input to remove the selected file
            const imageInput = document.getElementById('images');
            const dt = new DataTransfer();
            const files = imageInput.files;

            for (let i = 0; i < files.length; i++) {
                if (i !== index) {
                    dt.items.add(files[i]);
                }
            }

            imageInput.files = dt.files;
        }

        // Variant management with repeater
        let variantRepeater;

        // Initialize variant repeater
        $(document).ready(function () {
            console.log('Document ready, checking jQuery and repeater...');
            console.log('jQuery version:', $.fn.jquery);
            console.log('Repeater available:', typeof $.fn.repeater);
            console.log('Variant repeater element exists:', $('.variant-repeater').length > 0);
            
            // Always set up event listeners first
            setupVariantEventListeners();
            
            if (typeof $.fn.repeater === 'undefined') {
                console.error('jQuery repeater is not loaded!');
                // Fallback: Add manual button functionality
                setupManualVariantButtons();
                return;
            }
            
            if ($('.variant-repeater').length) {
                console.log('Variant repeater element found, initializing...');
                
                try {
                    variantRepeater = $('.variant-repeater').repeater({
                        initEmpty: false,
                        defaultValues: {
                            'type': '',
                            'values': ''
                        },
                        show: function () {
                            console.log('Adding new variant row');
                            $(this).slideDown();
                            // Re-setup event listeners for new elements
                            setupVariantEventListeners();
                            updateVariantPreview();
                        },
                        hide: function (deleteElement) {
                            console.log('Removing variant row');
                            $(this).slideUp(deleteElement);
                            setTimeout(updateVariantPreview, 300);
                        },
                        ready: function (setIndexes) {
                            console.log('Repeater ready');
                            updateVariantPreview();
                        }
                    });

                    console.log('Variant repeater initialized successfully');
                    // Initial preview update
                    updateVariantPreview();
                } catch (error) {
                    console.error('Error initializing repeater:', error);
                    setupManualVariantButtons();
                }
            } else {
                console.log('Variant repeater element not found');
                setupManualVariantButtons();
            }
        });

        // Setup event listeners for variant inputs
        function setupVariantEventListeners() {
            // Remove existing listeners to prevent duplicates
            $(document).off('input.variants', '.variant-type, .variant-values');
            $(document).off('keyup.variants', '.variant-type, .variant-values');
            
            // Add new listeners
            $(document).on('input.variants keyup.variants', '.variant-type, .variant-values', function() {
                console.log('Variant input changed:', $(this).attr('class'), $(this).val());
                updateVariantTags($(this));
                updateVariantPreview();
            });
        }

        // Fallback manual variant management
        function setupManualVariantButtons() {
            console.log('Setting up manual variant buttons...');
            
            // Handle add button
            $(document).on('click', '[data-repeater-create]', function(e) {
                e.preventDefault();
                console.log('Manual add variant clicked');
                addVariantRowManually();
            });

            // Handle delete buttons
            $(document).on('click', '[data-repeater-delete]', function(e) {
                e.preventDefault();
                console.log('Manual delete variant clicked');
                $(this).closest('[data-repeater-item]').remove();
                updateVariantPreview();
            });

            // Initial preview update
            updateVariantPreview();
        }

        function addVariantRowManually() {
            const container = $('[data-repeater-list="variants"]');
            const template = $('[data-repeater-item]').first().clone();
            
            // Clear values in template
            template.find('input').val('');
            template.find('.variant-preview-tags').html('<small class="text-muted">No values specified</small>');
            
            container.append(template);
            
            // Re-setup event listeners for the new row
            setupVariantEventListeners();
            updateVariantPreview();
        }

        // Update variant tags for a specific row
        function updateVariantTags($input) {
            if ($input.hasClass('variant-values')) {
                const values = $input.val().split(',').map(v => v.trim()).filter(v => v.length > 0);
                const $previewContainer = $input.closest('[data-repeater-item]').find('.variant-preview-tags');
                
                console.log('Updating variant tags for values:', values, 'Container found:', $previewContainer.length);
                
                if (values.length > 0) {
                    const tags = values.map(value => 
                        `<span class="badge bg-secondary me-1 mb-1">${value}</span>`
                    ).join('');
                    $previewContainer.html(tags);
                } else {
                    $previewContainer.html('<small class="text-muted">No values specified</small>');
                }
            }
        }

        // Update variant preview
        function updateVariantPreview() {
            console.log('Updating variant preview...');
            const previewContainer = document.getElementById('variantPreview');
            if (!previewContainer) {
                console.error('Variant preview container not found');
                return;
            }

            const variants = [];
            
            // Collect all variant data from repeater
            $('.variant-repeater [data-repeater-item]').each(function(index) {
                const $item = $(this);
                const type = $item.find('.variant-type').val().trim();
                const valuesString = $item.find('.variant-values').val().trim();
                
                console.log(`Variant ${index}: type="${type}", values="${valuesString}"`);
                
                if (type && valuesString) {
                    const values = valuesString.split(',').map(v => v.trim()).filter(v => v.length > 0);
                    if (values.length > 0) {
                        variants.push({ type, values });
                    }
                }
            });

            console.log('Valid variants found:', variants.length, variants);

            if (variants.length === 0) {
                previewContainer.innerHTML = '<small class="text-muted">No variants configured</small>';
                return;
            }

            // Calculate total combinations
            const totalCombinations = variants.reduce((total, variant) => {
                return total * (variant.values.length || 1);
            }, 1);

            const previewHTML = `
                <div class="alert alert-info">
                    <strong>Variant Preview:</strong><br>
                    ${variants.map(v => `${v.type}: ${v.values.join(', ')}`).join('<br>')}
                    <br><small class="text-muted">Total combinations: ${totalCombinations}</small>
                </div>
            `;
            
            console.log('Setting preview HTML:', previewHTML);
            previewContainer.innerHTML = previewHTML;
        }

        // Expose functions to window for debugging
        window.testVariantPreview = updateVariantPreview;
        window.testVariantTags = updateVariantTags;

        // Show/hide frozen temperature field
        const frozenField = document.getElementById('frozen');
        if (frozenField) {
            frozenField.addEventListener('change', function () {
                const tempField = document.querySelector('.frozen-temp-field');
                if (tempField) {
                    if (this.checked) {
                        tempField.style.display = 'block';
                    } else {
                        tempField.style.display = 'none';
                        const maxTempField = document.getElementById('maxTemperature');
                        if (maxTempField) maxTempField.value = '';
                    }
                }
            });
        }

        // Show/hide expiry date field
        const expiryField = document.getElementById('hasExpiryDate');
        if (expiryField) {
            expiryField.addEventListener('change', function () {
                const expiryDateField = document.querySelector('.expiry-date-field');
                if (expiryDateField) {
                    if (this.checked) {
                        expiryDateField.style.display = 'block';
                    } else {
                        expiryDateField.style.display = 'none';
                        const expiryInput = document.getElementById('expiryDate');
                        if (expiryInput) expiryInput.value = '';
                    }
                }
            });
        }

        // Show/hide countries selector based on global delivery selection
        document.addEventListener('change', function (e) {
            if (e.target.name === 'globalDelivery') {
                const countriesContainer = document.getElementById('countriesContainer');
                if (e.target.value === 'selected-countries') {
                    countriesContainer.style.display = 'block';
                } else {
                    countriesContainer.style.display = 'none';
                    // Clear selected countries when hiding
                    $('#selectedCountries').val(null).trigger('change');
                }
            }
        });

        document.getElementById('addProductForm').addEventListener('submit', async function (event) {
            event.preventDefault();

            const form = event.target;
            const formData = new FormData(form);
            
            // Remove all variant-related fields that may have been auto-added by the repeater
            // The repeater generates field names like variants[0][type], variants[0][values], etc.
            const keysToDelete = [];
            for (let [key, value] of formData.entries()) {
                if (key.startsWith('variants[') || key === 'type' || key === 'values') {
                    keysToDelete.push(key);
                }
            }
            keysToDelete.forEach(key => formData.delete(key));

            // Handle checkbox values explicitly - checkboxes don't get included in FormData when unchecked
            const inStockCheckbox = document.getElementById('inStock');
            const chargeTaxCheckbox = document.getElementById('chargeTax');
            
            // Explicitly set the values in FormData
            formData.set('inStock', inStockCheckbox.checked ? 'yes' : 'no');
            formData.set('chargeTax', chargeTaxCheckbox.checked ? 'yes' : 'no');

            // Handle Tagify tags properly
            if (tagify && tagify.value) {
                const tagsArray = tagify.value.map(tag => tag.value);
                formData.set('tags', tagsArray.join(','));
            }

            // Handle selectedCountries field properly
            const selectedCountries = $('#selectedCountries').val();
            console.log('Selected Countries:', selectedCountries); // Debugging log
            if (selectedCountries && selectedCountries.length > 0) {
                formData.append('selectedCountries', JSON.stringify(selectedCountries));
            } else {
                formData.append('selectedCountries', '[]');
            }

            // Handle variants from repeater
            console.log('=== VARIANT COLLECTION DEBUG ===');
            console.log('Variant repeater elements found:', $('.variant-repeater').length);
            console.log('Variant repeater items found:', $('.variant-repeater [data-repeater-item]').length);
            
            const variants = [];
            $('.variant-repeater [data-repeater-item]').each(function(index) {
                console.log(`Processing variant row ${index}:`);
                
                const $typeInput = $(this).find('.variant-type');
                const $valuesInput = $(this).find('.variant-values');
                
                console.log('  Type input found:', $typeInput.length);
                console.log('  Values input found:', $valuesInput.length);
                
                const type = $typeInput.val() ? $typeInput.val().trim() : '';
                const valuesString = $valuesInput.val() ? $valuesInput.val().trim() : '';
                
                console.log('  Type value:', `"${type}"`);
                console.log('  Values value:', `"${valuesString}"`);
                
                if (type && valuesString) {
                    const values = valuesString.split(',').map(v => v.trim()).filter(v => v.length > 0);
                    console.log('  Parsed values:', values);
                    if (values.length > 0) {
                        const variant = { type, values };
                        variants.push(variant);
                        console.log('  Added variant:', variant);
                    }
                } else {
                    console.log('  Skipped - missing type or values');
                }
            });
            
            console.log('Final variants array:', variants);
            console.log('Variants to be sent:', variants);
            console.log('=== END VARIANT DEBUG ===');
            
            // Always append variants (even if empty array)
            formData.append('variants', JSON.stringify(variants));
            console.log('Added variants to FormData:', JSON.stringify(variants));
            
            // Debug: Log all FormData entries after cleanup
            console.log('=== FINAL FORMDATA ENTRIES ===');
            for (let [key, value] of formData.entries()) {
                console.log(key, ':', value);
            }
            console.log('=== END FORMDATA DEBUG ===');

            try {
                const response = await fetch(form.action, {
                    method: form.method,
                    body: formData
                });

                if (response.ok) {
                    const result = await response.json();
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: 'Product added successfully!',
                        confirmButtonText: 'La7aaafdk'
                    }).then(() => {
                        window.location.href = '/view-products';
                    });
                } else {
                    console.log('Response not ok:', response.status, response.statusText);
                    const error = await response.json();
                    console.log('Error response:', error);
                    
                    let errorMessage = error.error || 'Failed to add product.';
                    if (error.details && Array.isArray(error.details)) {
                        errorMessage += '\n\nDetails:\n' + error.details.join('\n');
                    }
                    
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: errorMessage,
                        confirmButtonText: 'OK'
                    });
                }
            } catch (err) {
                console.log('Fetch error:', err);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An unexpected error occurred: ' + err.message,
                    confirmButtonText: 'OK'
                });
            }
        });

    </script>

</body>

</html>